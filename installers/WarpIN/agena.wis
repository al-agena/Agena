<!-- Agena WarpIN installation profile. -->

<WARPIN VERSION="1.0.26" CODEPAGE=850>

<HEAD>

<PCK INDEX=1
     PACKAGEID="Alexander Walz\Agena\Agena\7\9\2"
     TARGET="$(WARPIN_DEFAULTAPPSPATH)\agena"
     TITLE="Agena"
     CONFIGSYS="set AGENAPATH=$(/1)/LIB | UNIQUE"
     CONFIGSYS="set PATH=$(/1)/BIN | ADDRIGHT"
     CREATEOBJECT="REPLACE WPFolder|Agena|<WP_DESKTOP>|OBJECTID=<AGENA_FOLDER>"
     CREATEOBJECT="REPLACE WPProgram|Agena|<AGENA_FOLDER>|EXENAME=$(1)\bin\agena.exe;ICONFILE=$(1)\share\agena256.ico;OBJECTID=<AGENA_EXE>;ASSOCFILTER=*.agn"
     CREATEOBJECT="REPLACE WPShadow|Primer|<AGENA_FOLDER>|SHADOWID=$(1)\doc\agena-primer.pdf;OBJECTID=<AGENA_PRIMER>;"
     CREATEOBJECT="REPLACE WPShadow|Reference|<AGENA_FOLDER>|SHADOWID=$(1)\doc\agena-reference.pdf;OBJECTID=<AGENA_REFERENCE>;"
     CREATEOBJECT="REPLACE WPShadow|Crash Course|<AGENA_FOLDER>|SHADOWID=$(1)\doc\agena-crashcourse.pdf;OBJECTID=<AGENA_CRASHCOURSE>;"
     CREATEOBJECT="REPLACE WPShadow|Quick Reference|<AGENA_FOLDER>|SHADOWID=$(1)\doc\agena-quickref.xls;OBJECTID=<AGENA_QUICKREF>;"
     CREATEOBJECT="REPLACE WPProgram|Change Log|<AGENA_FOLDER>|EXENAME=epm.exe;PARAMETERS=$(1)\change.log;OBJECTID=<AGENA_CHANGELOG>;"
     CREATEOBJECT="REPLACE WPProgram|Licence|<AGENA_FOLDER>|EXENAME=epm.exe;PARAMETERS=$(1)\licence;OBJECTID=<AGENA_LICENCE>;"
     SELECT
     >This package will install Agena, a procedural programming language.
</PCK>
</HEAD>

<!-- Install control pages. They are linked by
     the <NEXTBUTTON> tags, which must have a target.
     Each page must have a TYPE= attribute, which tells
     WarpIn what will be visible on that page. -->

<BODY>

<PAGE INDEX=1 TYPE=TEXT>
<NEXTBUTTON TARGET=2>~Next</NEXTBUTTON>
<TEXT>

Agena is an easy-to-learn procedural programming language designed for science, scripting, and many other applications.

Its syntax looks like very simplified Algol 68 with elements taken from Lua and SQL.

The implementation is based on the original Lua 5.1 sources written by Roberto Ierusalimschy, Luiz Henrique de Figueiredo, and Waldemar Celes.

This archive installs or refreshes Agena. You can use the archive to update an existing installation, as well.

Select "Next" to continue.

Select "Cancel" to abort installation.
</TEXT>
</PAGE>


<!-- The TYPE_README will show a README text in a multi-line entry field. -->

<PAGE INDEX=2 TYPE=README>
<NEXTBUTTON TARGET=3>~I agree</NEXTBUTTON>
<TEXT>
By pressing the "I agree" button, you agree to all terms and conditions to the following licence agreement.
</TEXT>
<README>
AGENA Copyright 2006-2026 by Alexander Walz. All rights reserved.
Portions Copyright 1994-2026 Lua.org, PUC-Rio. All rights reserved.

See licence file in the Agena folder. In short: The sources are published under
the MIT licence, the binaries under GPL 2.
</README>
</PAGE>

<!-- The TYPE=CONTAINER will list the packages which can be installed. -->

<PAGE INDEX=3 TYPE=CONTAINER>
<NEXTBUTTON TARGET=4>~Next</NEXTBUTTON>
<TEXT>
Please select the packages which are to be installed. You may change the target paths for the packages.
</TEXT>
</PAGE>


<!-- The TYPE=CONFIGURE will allow the user to set the CONFIG.SYS and
     WPS classes/objects stuff. -->

<PAGE INDEX=4 TYPE=CONFIGURE>
<NEXTBUTTON TARGET=5>~Next</NEXTBUTTON>
<TEXT>

Please select additional configuration that WarpIN should perform after installing this archive.

</TEXT>
</PAGE>

<!-- Here's another TYPE=TEXT page before we install.
     The special target "0" indicates that after this page we
     should start installation.
     Note that the TYPE=INSTALL page (which we had in Alpha #3)
     is no longer supported. -->

<PAGE INDEX=5 TYPE=TEXT>
<NEXTBUTTON TARGET=0>I~nstall</NEXTBUTTON>
<TEXT>

Press "Install" to begin installing this archive.</TEXT>
</PAGE>
</BODY>
</WARPIN>