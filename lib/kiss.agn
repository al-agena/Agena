This is an Agena port of the KissFFT Library by Mark Borgerding.

It provides a simple function `kiss.fft` to carry out a fast fourier transformation (FFT),
see example at the bottom of this file.

LuaFFT
------

1.3.1 Beta [Mar.2025, by A. Walz, agena.sourceforge.net]
========================================================
* Removed a typo in a variable name used in butterfly_generic.
* Fixed wrong operator in butterfly5, see comment there.
* The original Lua functions `work` and `butterfly5` inadvertently change the input
  structure, the Agena implementation does not.
* Minor tuning of `kiss.fft`, `kiss.nextsize`, `work`, `butterfly3` and `butterfly5`.

1.2 Beta [Nov.2017]
========================================================
* Minor change to upgrade to Lua 5.2.

1.1 Beta [Dec.2011]
========================================================
* Added assert msg if input data has not the correct size.
* Now fft also takes number values as input. It automatically translates them into complex numbers.
* Changed example to a simple audio fft with frequencies.

1.0 Beta [Jan.2011]
========================================================
* Initial first version with single luafft function.

Taken from: https://luarocks.org/modules/h4rm/luafft
See also:   https://github.com/mborgerding/kissfft */

create table kiss;


/* Returns the next possible size for data input

   @param n	Size

   @return	Next fast size. */
procedure kiss.nextsize (n :: posint) is
   local m;
   do
      m := n;
      while m % 2 = 0 do m /:= 2 end;
      while m % 3 = 0 do m /:= 3 end;
      while m % 5 = 0 do m /:= 5 end;
    	break when m <= 1;  /* n is completely factorable by twos, threes, and fives */
      n++
   end;
   return n
end;


/* divides a number into a sequence of factors
   @param n:  Number of points that are used.
   @return:   Returns a list with the factors */
procedure kiss.factors (n :: posint) is
   local buf, p, floor_sqrt := [], 4, math.isqrt(n);
   do
      while n % p > 0 do
         if p = 4 then p := 2
         elif	p = 2 then p := 3
         else p +:= 2
         end;
         p > floor_sqrt ? p := n
      end;
      n /:= p;
      insert p, n into buf
   until n <= 1;
   return buf
end;


/* Carries out a butterfly 2 run of the input sample. */
local procedure butterfly2 (input, out_index, fstride, twiddles, m, inverse)
   local i1, i2, ti := out_index, out_index + m, 1;
   do
      local t := input[i2]*twiddles[ti];
      ti +:= fstride;
      input[i2] := input[i1] - t;
      input[i1] +:= t;
      i1++; i2++; m--
   until m = 0
end;


/* Carries out a butterfly 3 run of the input sample. */
local procedure butterfly3 (input, out_index, fstride, twiddles, m, inverse) is
   local k, m2, tw1, tw2, scratch, epi3, i;
   k, m2, scratch := m, 2*m, [];
   tw1, tw2 -> 1;
   epi3 := twiddles[fstride*m];
   i := out_index;
   do
      scratch[1] := input[i + m] * twiddles[tw1];
      scratch[2] := input[i + m2] * twiddles[tw2];
      scratch[3] := scratch[1] + scratch[2];
      scratch[0] := scratch[1] - scratch[2];
      tw1, tw2 := tw1 + fstride, tw2 + 2*fstride;
      input[i + m] := input[i] - 0.5*scratch[3];
      scratch[0] := imag(epi3)*scratch[0];
      input[i] +:= scratch[3];
      input[i + m2] := (real(input[i + m]) + imag(scratch[0]))!(imag(input[i + m]) - real(scratch[0]));
      input[i + m]  := (real(input[i + m]) - imag(scratch[0]))!(imag(input[i + m]) + real(scratch[0]));
      i++; k--
   until k = 0
end;


/* Carries out a butterfly 4 run of the input sample. */
local procedure butterfly4 (input, out_index, fstride, twiddles, m, inverse) is
   local ti1, ti2, ti3 -> 1;
   local scratch, k := [], m;
   local m2, m3, i := 2*m, 3*m, out_index;
   do
      scratch[0] := input[i + m]*twiddles[ti1];
      scratch[1] := input[i + m2]*twiddles[ti2];
      scratch[2] := input[i + m3]*twiddles[ti3];
      scratch[3] := scratch[0] + scratch[2];
      scratch[4] := scratch[0] - scratch[2];
      scratch[5] := input[i] - scratch[1];
      input[i] +:= scratch[1];
      input[i + m2] := input[i] - scratch[3];
      ti1 +:= fstride;
      ti2 +:= 2*fstride;
      ti3 +:= 3*fstride;
      input[i] +:= scratch[3];
      if inverse then
         input[i + m]  := (real(scratch[5]) - imag(scratch[4]))!(imag(scratch[5]) + real(scratch[4]));
         input[i + m3] := (real(scratch[5]) + imag(scratch[4]))!(imag(scratch[5]) - real(scratch[4]))
      else
         input[i + m]  := (real(scratch[5]) + imag(scratch[4]))!(imag(scratch[5]) - real(scratch[4]));
         input[i + m3] := (real(scratch[5]) - imag(scratch[4]))!(imag(scratch[5]) + real(scratch[4]))
      end;
      i++; k--
   until k = 0
end;


/* Carries out a butterfly 5 run of the input sample. */
local procedure butterfly5 (input, out_index, fstride, twiddles, m, inverse) is
   local i0, i1, i2, i3, i4 := out_index, out_index + m, out_index + 2*m, out_index + 3*m, out_index + 4*m;
   local scratch, tw := [], twiddles;
   local ya, yb := tw[1 + fstride*m], tw[1 + 2*fstride*m];
   local yare, ybre, yaim, ybim, scr0re, scr7re, scr8re, scr9re, scr10re, scr0im, scr7im, scr8im, scr9im, scr10im;
   for u from 0 to m - 1 do
      scratch[0]  := input[i0];
      scratch[1]  := input[i1] * tw[1 + u*fstride];
      scratch[2]  := input[i2] * tw[1 + 2*u*fstride];
      scratch[3]  := input[i3] * tw[1 + 3*u*fstride];
      scratch[4]  := input[i4] * tw[1 + 4*u*fstride];
      scratch[7]  := scratch[1] + scratch[4];
      scratch[8]  := scratch[2] + scratch[3];
      scratch[9]  := scratch[2] - scratch[3];
      scratch[10] := scratch[1] - scratch[4];
      yare, ybre, yaim, ybim := real(ya), real(yb), imag(ya), imag(yb);
      scr0re, scr0im := real(scratch[0]), imag(scratch[0]);
      scr7re, scr7im := real(scratch[7]), imag(scratch[7]);
      scr8re, scr8im := real(scratch[8]), imag(scratch[8]);
      scr9re, scr9im := real(scratch[9]), imag(scratch[9]);
      scr10re, scr10im := real(scratch[10]), imag(scratch[10]);
      input[i0]  +:= scratch[7] + scratch[8];
      scratch[5]  := (scr0re + scr7re*yare + scr8re*ybre)!
                     (scr0im + scr7im*yare + scr8im*ybre);
      scratch[6]  := ( scr10im*yaim + scr9im*ybim)!
                     (-scr10re*yaim - scr9re*ybim);  /* operator changed from + to - just like in KISSFFT 131.1.0 */
      input[i1]   := scratch[5] - scratch[6];
      input[i4]   := scratch[5] + scratch[6];
      scratch[11] := (scr0re + scr7re*ybre + scr8re*yare)!
                     (scr0im + scr7im*ybre + scr8im*yare);
      scratch[12] := (-scr10im*ybim + scr9im*yaim)!
                     ( scr10re*ybim - scr9re*yaim);
      input[i2] := scratch[11] + scratch[12];
      input[i3] := scratch[11] - scratch[12];
      i0++; i1++; i2++; i3++; i4++
   end
end;


/* Carries out a generic butterfly run of the input sample. */
local procedure butterfly_generic (input, out_index, fstride, twiddles, m, p, inverse) is
   local norig, scratchbuf := size input, [];
   for u from 0 to m - 1 do
      local k := u;
      for q1 from 0 to p - 1 do
         scratchbuf[q1] := input[out_index + k];
         k +:= m
      end;
      k := u;
      for q1 from 0 to p - 1 do
         local twidx := 0;
         input[out_index + k] := scratchbuf[0];
         for q to p - 1 do
            twidx +:= fstride*k;
            twidx >= norig ? twidx -:= norig;
            input[out_index + k] +:= scratchbuf[q] * twiddles[1 + twidx]
         end;
         k +:= m
      end
   end
end;


/* The essential work function that performs the FFT */
local procedure work (input, output, out_index, f, factors, factors_index, twiddles, fstride, in_stride, inverse) is
   local p, m := factors[factors_index], factors[factors_index + 1];
   factors_index +:= 2
   local last, beg := out_index + p*m, out_index;
   if m = 1 then
		  do
         output[out_index] := input[f];
         f +:= fstride*in_stride;
         out_index++
      until out_index = last
   else
      do
         procname(input, output, out_index, f, factors, factors_index, twiddles, fstride*p, in_stride, inverse);
         f +:= fstride*in_stride;
         out_index +:= m
      until out_index = last
   end;
   out_index := beg;
   case p
      of 2 then
         butterfly2(output, out_index, fstride, twiddles, m, inverse)
      of 3 then
         butterfly3(output, out_index, fstride, twiddles, m, inverse)
      of 4 then
         butterfly4(output, out_index, fstride, twiddles, m, inverse)
      of 5 then
         butterfly5(output, out_index, fstride, twiddles, m, inverse)
      else
         butterfly_generic(output, out_index, fstride, twiddles, m, p, inverse)
      esle
   esac
end;


/* Calculates the Fast Fourier Transformation of the given input

   @param input		A set of points that will be transformed.
					At this point, the input has to be a list of complex numbers,
					according to the format in complex.lua.
   @param inverse	Boolean that controls whether a transformation
					or inverse transformation will be carried out.
   @return			Returns a list of complex numbers with the same size
					as the input list. Contains the fourier transformation of the input. */
procedure kiss.fft (input, inverse) is
   # the size of input defines the number of total points
   local num_points, twiddles, factors, output, ph := size input, [];
   if num_points <> kiss.nextsize(num_points) then
      error('The size of your input is not correct. For your size=' & num_points & ',\n' &
            'use a table of size=' & kiss.nextsize(num_points) & ' with zeros at the end.')
   fi;
   ph := -Pi2*I/num_points;
   inverse ? ph := -ph;
   for i from 0 to num_points - 1 do
      twiddles[i + 1] := exp(i*ph)  # phase = -Pi2*i/num_points; exp(i*ph) = cos(phase)!sin(phase)
   end;
   factors, output := kiss.factors(num_points), [];
   work(input, output, 1, 1, factors, 1, twiddles, 1, 1, inverse);
   return output
end;


/*
import kiss

signal := []
s := kiss.nextsize(2*2048 + 1)
#s := kiss.nextsize(4*8*8*2048 + 1)
frequency := 1024;
length := s/frequency

# Populates a list with random real numbers in complex format
procedure populate(list, s) is
   for i to s do
	    list[i] := (sin(2*i/frequency*Pi2) + sin(10*i/frequency*Pi2))!0  # ~math.random()!0
   end
end

# displays the fourier spectrum
procedure display(spectrum) is
   for i to size(spectrum)/2 do
      print(strings.format("%.1f Hz\t%1.3f",(i - 1)/length, (abs spectrum[i])))
   end
end

# create a signal with two sine waves
populate(signal, s)

# carry out fast fourier transformation and store result in "spec"

spec := kiss.fft(signal, false)

# After retransformation, we need to divide by the data size s/2.
map(<: x, s -> 2*x/s :>, spec, s, inplace = true);

# Displays the fourier spectrum of the audio signal
display(spec)

0.0 Hz  0.078
0.2 Hz  0.079
0.5 Hz  0.082
0.7 Hz  0.088
0.9 Hz  0.099
1.2 Hz  0.118
1.4 Hz  0.154
1.7 Hz  0.241
1.9 Hz  0.737
