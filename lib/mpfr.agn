# The mpfr package

package.checkclib('mpfr');  # has C dynamic link library been found ?

# mpfr.initstring := 'mpfr package v1.0.0 as of August 23, 2023\n';

mpfr.naught     := mpfr.new('0');
mpfr.nought     := mpfr.naught;
mpfr.one        := mpfr.new('1');
mpfr.two        := mpfr.new('2');
mpfr.three      := mpfr.new('3');
mpfr.four       := mpfr.new('4');
mpfr.five       := mpfr.new('5');
mpfr.six        := mpfr.new('6');
mpfr.seven      := mpfr.new('7');
mpfr.eight      := mpfr.new('8');
mpfr.nine       := mpfr.new('9');
mpfr.ten        := mpfr.new('10');
mpfr.eleven     := mpfr.new('11');
mpfr.twelve     := mpfr.new('12');
mpfr.fifty      := mpfr.new('50');
mpfr.hundred    := mpfr.new('100');
mpfr.thousand   := mpfr.new('1000');

mpfr.half       := mpfr.new('0.5');
mpfr.quarter    := mpfr.new('0.25');
mpfr.tenth      := mpfr.new('0.1');
mpfr.fifth      := mpfr.new('0.2');
mpfr.hundredth  := mpfr.new('0.01');
mpfr.thousandth := mpfr.new('0.001');

mpfr.threequarter := mpfr.new('0.75');
mpfr.third      := mpfr.divide(1, 3);
mpfr.sixth      := mpfr.divide(1, 6);
mpfr.eighth     := mpfr.new('0.125');
mpfr.twelfth    := mpfr.divide(1, 12);
mpfr.sixteenth  := mpfr.new('0.0625');

mpfr.infinity   := mpfr.new(infinity);
mpfr.undefined  := mpfr.new(undefined);

mpfr.I := sqrt(mpfr.new(-1, 0));
mpfr.E := exp(mpfr.new(1));

mpfr.hypot4 := mpfr.cathet
