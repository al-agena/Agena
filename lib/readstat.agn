L.data[5]:
*/

/* The function fills all empty, missing cells in the rows of the payload referred to by the 'data' field of an
   SPSS Statistical File object with a user-defined value. */
procedure readstat.fillmissing(dataset, numericfill, stringfill) is
   for i, row in ipairs(dataset.data) do
      for c, var in ipairs(dataset.variables) do
         if row[c] = null then
            if var['type'] = 'string' then
               row[c] := stringfill or ''
            else
               row[c] := numericfill or -999
            end
         end
      end
   end;
   return dataset
end;

