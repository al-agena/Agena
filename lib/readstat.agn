package.checkclib('readstat');  # has C dynamic link library been found ?

/*
import readstat;
L := readstat.read("C:/Program Files/PSPP-TESTING/share/pspp/examples/nhtsa.sav");
readstat.save(L, "nhtsa.new.sav");
K := readstat.read("nhtsa.new.sav");
L = K:

L.data[5]:
readstat.fillmissing(L, undefined, 'NaN')
L.data[5]:
*/

/* The function fills all empty, missing cells in the rows of the payload referred to by the 'data' field of an
   SPSS Statistical File object with a user-defined value. */
procedure readstat.fillmissing(dataset, numericfill, stringfill) is
   for i, row in ipairs(dataset.data) do
      for c, var in ipairs(dataset.variables) do
         if row[c] = null then
            if var['type'] = 'string' then
               row[c] := stringfill or ''
            else
               row[c] := numericfill or -999
            end
         end
      end
   end;
   return dataset
end;


procedure readstat.save(obj :: table, ?) is  # new 7.12.11
   if tables.isrectangular(obj) then
      local L := [];
      L.data := obj;
      return procname(L, op(?))
   fi;
   if unassigned obj.data then
      error('Error in `readstat.save`: table does not have a `data` field.')
   fi;
   local rc, rows, cols := tables.isrectangular(obj.data);
   if not rc then
      error('Error in `readstat.save`: `data` field is corrupt.')
   fi;
   if unassigned obj.variables then
      local types := tables.col(obj.data, 'types');
      local L := [];
      for c to size types do
         local coldata, spsstype, format := types[c];
         if size coldata <> 1 then
            error('Error in `readstat.save`: `data` field contains a column of mixed types.')
         fi;
         coldata := op(coldata);  # unpack pair from set
         case left coldata
            of number then
               spsstype := 'numeric';
               format := if right coldata = 0 then 'F8.0' else 'F12.6' fi
            of string then
               spsstype := 'string';
               format := 'A' & max(1, right coldata)  # 'A0' for an empty string is invalid, 'A1' is valid.
            of boolean then
               spsstype := 'numeric';
               format := 'F8.0'
               # readstat.write will convert the boolean to integers -1 (fail), 0 or 1
            else
               error('Error in `readstat.save`: `data` field has data of type ' & left coldata & '.')
            esle
         esac;
         insert ['name' ~ 'v' & c, 'type' ~ spsstype, 'format' ~ format] into L
      od;
      obj.variables := L
   fi;
   return readstat.write(obj, op(?))
end;

