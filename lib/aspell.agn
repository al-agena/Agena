aspell.list := proc() is
   for keys code in aspell.languages do
      if local speller := aspell.new(code) then
         local info, r := speller@@getdictinfo(), [];
         for entry in info do
            local jargon := entry.jargon;
            if jargon = '' then jargon := null fi;
            local module := entry.module;
            if module = 'default' then module := null fi;
            tables.include(r, entry.code,
               [jargon ~ jargon,
                module ~ module,
                name   ~ entry.name,
                'size' ~ entry['size']])
         od;
         for i, j in r do
            put(j, 1, aspell.languages[i] or 'unknown')
         od;
         speller@@close();
         return r
      fi
   od;
   return null
end;


# aspell.norm: Takes a string and an Aspell substitution table, the latter read in by aspell.rules from
# an Aspell *phonet.dat file or created manually, and normalises the string. Written by Gemini AI for
# Lua 5.1, ported to Agena by A. Walz, put to the public domain. 7.12.3.

local aspellparserule := proc(pattern, replacement) is
   # Initialize the rule object with default metadata flags
   local rule := [
      original    ~ pattern,      # Stores the unparsed pattern string for debugging
      replacement ~ replacement,  # The target text to substitute into the word
      rewind      ~ false,        # Set to true if the rule contains '<'
      doublecaret ~ false,        # Set to true if the rule contains '^^'
      anchorstart ~ false,        # Set to true if the pattern applies only to the start of a word
      anchorend   ~ false,        # Set to true if the pattern applies only to the end of a word
      priority    ~ 5,            # Dictates when this rule executes relative to others
      slicelimit  ~ 0             # Tracks partial replacement limits (e.g., German Y(AOU)-<7)
   ];
   # This working copy will be stripped down step-by-step into a pure matching string
   local cleanpat := pattern;
   # 1. Extract Rewind Flag: If '<' exists, enable rewind and remove the symbol
   if cleanpat@@find('<') then rule.rewind := true; cleanpat := cleanpat@@gsub('<', '') fi;
   # 2. Extract End Anchor: If '$' exists, flag it and remove the symbol
   if cleanpat@@find('%$') then rule.anchorend := true; cleanpat := cleanpat@@gsub('%$', '') fi;
   # 3. Extract Carets: '^^' means isolate suffix, '^' means start of word boundary, or in other words:
   # If a word starts with this specific prefix, cut it off, translate it to its sound, and then completely
   # reset to process the rest of the word as if it were a brand-new word.
   if cleanpat@@find('%^%^') then
      rule.doublecaret, rule.anchorstart -> true;
      cleanpat := cleanpat@@gsub('%^%^', '')
   elif cleanpat@@find('%^') then
      rule.anchorstart := true;
      cleanpat := cleanpat@@gsub('%^', '')
   fi
   # 4. Extract Trailing Priority Digit (0-9) at the end of the control suffix
   local prio_digit := cleanpat@@match("(%d)$")
   if prio_digit then
      rule.priority := tonumber(prio_digit);
      cleanpat := cleanpat@@gsub("%d$", "")
   end;
   # 5. Count Trailing Hyphens ('-') for unconsumed suffix length (slice_limit)
   local hyphens := cleanpat@@match("(%-+)$")
   if hyphens then
       rule.slicelimit := size hyphens;
       cleanpat := cleanpat@@gsub("%-+$", "")
   end;
   # 6. Convert Bracket Groups: Translate Aspell formatting '(ABC)' into a Lua set class '[ABC]'
   cleanpat := cleanpat@@gsub('%((.-)%)', '[%1]');
   # Assign the fully cleaned native search pattern back to the object configuration
   rule.pattern := cleanpat;
   return rule
end;

aspell.Segment :=
   # vowels and consonants
   ['V' ~ ['a', 'e', 'i', 'y', 'o', 'u', 'h'],
    'C' ~ ['b', 'p', 'w', 'v', 'f', 'd', 't', 'j', 'l', 'm', 'n', 'r',
           'c', 'g', 'k', 'q', 's', 'x', 'z', '@']
   ];

local phqparserule := proc(pattern, replacement) is
   # Initialize the rule object with default metadata flags
   local rule := [
      original    ~ pattern,      # Stores the unparsed pattern string for debugging
      replacement ~ replacement,  # The target text to substitute into the word
      rewind      ~ false,        # Set to true if the rule contains '<'
      doublecaret ~ false,        # Set to true if the rule contains '^^'
      anchorstart ~ false,        # Set to true if the pattern applies only to the start of a word
      anchorend   ~ false,        # Set to true if the pattern applies only to the end of a word
      priority    ~ 0,            # Dictates when this rule executes relative to others
      slicelimit  ~ null,         # Tracks partial replacement limits (e.g., German Y(AOU)-<7)
      phonetiQs   ~ true
   ];
   # This working copy will be stripped down step-by-step into a pure matching string
   local cleanpat := pattern;
   # 1. Extract Rewind Flag: If '<' exists, enable rewind and remove the symbol
   if cleanpat@@find('<rewind>') then rule.rewind := true; cleanpat := cleanpat@@gsub('<rewind>', '') fi;
   # 2. Extract End Anchor: If '$' exists, flag it and remove the symbol
   if cleanpat@@find('<end>') then
      rule.anchorend := true;
      cleanpat := cleanpat@@gsub('<end>', '')
   fi;
   # 3. Extract Carets: '^^' means isolate suffix, '^' means start of word boundary, or in other words:
   # If a word starts with this specific prefix, cut it off, translate it to its sound, and then completely
   # reset to process the rest of the word as if it were a brand-new word.
   if cleanpat@@find('<isolate>') then
      rule.doublecaret, rule.anchorstart -> true;
      cleanpat := cleanpat@@gsub('<isolate>', '')
   fi;
   if cleanpat@@find('<begin>') then
      rule.anchorstart := true;
      cleanpat := cleanpat@@gsub('<begin>', '')
   fi;
   # 4. Convert Bracket Groups: Translate formatting '<:ABC:>' into a Lua set class '[ABC]'
   cleanpat := cleanpat@@gsub('<:(.-):>', '[%1]');
   # 5. Vowel placeholder
   cleanpat := cleanpat@@gsub('<vowel>', '([' & join(aspell.Segment.V) & '])');
   # 6. Consonant placeholder
   cleanpat := cleanpat@@gsub('<cons>', '([' & join(aspell.Segment.C) & '])');
   # 7. Letters
   cleanpat := cleanpat@@gsub('<alpha>', '([' & join(aspell.Segment.C) & join(aspell.Segment.V) & '])');
   # 8. ASCII placeholder
   cleanpat := cleanpat@@gsub('<char%((.-)%)>', char);
   # 9. Blanks
   cleanpat := cleanpat@@gsub('<blank>', ' ');
   # 10. Control characters
   cleanpat := cleanpat@@gsub('%%', '%');
   # Assign the fully cleaned native search pattern back to the object configuration
   rule.pattern := upper(cleanpat);
   # Treatment of replacement strings:
   rule.replacement := strings.gsub(rule.replacement, "<%%(%d+)>", "%%%1");
   for i in ['<empty>', '<begin>', '<end>'] do
      # <begin> and <end> in the replacement seem to not make sense anyway
      rule.replacement := replace(rule.replacement, i, '')
   od;
   for i in ['<blank>'] do
      rule.replacement := replace(rule.replacement, i, ' ')
   od;
   rule.replacement := upper(rule.replacement@@gsub('<char%((.-)%)>', char));
   return rule
end;

aspell.rules := proc(obj :: {string, table}, option) is
   local compiled, rawrules := [], obj;
   if obj :: string then
      if option then
         rawrules := io.readlines(obj, {'#', '\0', '\n', '['},
            <: x -> totable(strings.trim(x) split ' ') :>, true)
      else
         rawrules := io.readlines(obj,
            {'#', '\0', '\n', '\n\r', 'version', 'followup', 'collapse_result', 'remove_accents'},
            <: x -> totable(strings.trim(x) split ' ') :>, true)
      fi
   fi;
   # Iterate sequentially through every raw array entry in the list
   # rawrules[i, 1] is the raw string pattern, rawrules[i, 2] is the replacement text
   local parserule := if option then phqparserule else aspellparserule fi;
   for i to size rawrules do
      # Store the generated configuration table into the master tracking array
      insert parserule(op(rawrules[i])) into compiled
   od;
   # Sort the entire array table deterministically using a custom rule matrix
   sort(compiled, proc(a, b) is
      # First Level Sort: Higher numerical execution priority always runs first
      if a.priority <> b.priority then return a.priority > b.priority fi;
      # Tie-Breaker Sort: Longer, more specific search patterns take precedence over shorter ones
      return size a.pattern > size b.pattern
   end);
   return compiled
end;


