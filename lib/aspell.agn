aspell.norm('Scheibenwischer', en):

aspell.oldnorm := proc(word :: string, rules :: table) is
   # buffer: The active text canvas being mutated (starts as the input word)
   # cursor: The pointer tracking which character position we are currently evaluating
   local buffer, cursor := upper(word), 1;  # upper: prevent the function from going into infinite
   # Main Loop: Step character by character across the entire length of the mutable buffer
   while cursor <= size buffer do
      local matched := false;
      # Extract a temporary lookahead snapshot of the word remaining from the cursor to the end
      local curslice := buffer@@sub(cursor);
      # Rule Evaluation Loop: Test every sorted rule configuration against the current lookahead snapshot
      for i to size rules do
         local rule := rules[i];
         # Validate Start-of-Word Constraints
         # If a pattern requires a start-of-word anchor (^), it is illegal if we have already stepped forward
         local isvalid := not(rule.anchorstart and cursor > 1);
         if isvalid then
            # Search the snapshot. Adding '^' forces Lua to evaluate strictly at the first index of the snapshot
            local s, e, rulepattern;
            rulepattern := rule.pattern;
            if rulepattern = '\0' then next fi;  # get rid of stray NULLs
            if rule.phonetiQs and size rulepattern = 1 and rulepattern in '%()' then  # avoid invalid capture
               rulepattern := '%' & rulepattern[1]
            fi;
            s, e := curslice@@find('^' & rulepattern);
            # Verify the match aligns perfectly at index 1 of the snapshot (directly under our active tracking cursor)
            if s = 1 then
               # Validate End-of-Word Constraints
               if rule.anchorend and (cursor + e - 1) <> size buffer then
                  # If a pattern requires an end-of-word anchor ($), it is illegal if it does not span to the last index
                  isvalid := false
               fi;
               if isvalid then
                  # to cope with out-of-range cases, and there will be many, we use strings.sub instead of the substring operator
                  local matchedstr := curslice@@sub(s, e);
                  # Partial Replacement (Slice Limit) Calculation
                  local limit := rule.slicelimit or 0;
                  local cutlength := size matchedstr;
                  # If a slice limit is specified, restrict how much of the matched text gets overwritten
                  if 0 < limit < size matchedstr then
                     cutlength := size matchedstr - limit
                  fi;
                  # String Splicing Execution Matrix
                  # 1. Grab all text sitting safely BEFORE our active cursor position
                  local before := buffer@@sub(1, cursor - 1);
                  # 2. Grab all text sitting safely AFTER our calculated pattern overwrite zone
                  local after := buffer@@sub(cursor + cutlength);
                  # 3. Construct the new word layout sandwich with the replacement string in the middle
                  if rule.phonetiQs then
                     if strings.find(rule.pattern, '%(%[.-%]%)') then
                        buffer := before & strings.gsub(matchedstr, rule.pattern, rule.replacement) & after
                     else
                        buffer := before & rule.replacement & after
                     fi
                  elif rule.replacement = '_' then  # do not add matched substring to result
                     buffer := before & after
                  else
                     buffer := before & rule.replacement & after
                  fi;
                  matched := true;
                  # Double Caret Split Optimization Rule
                  if rule.doublecaret then
                     return before & rule.replacement & procname(after, rules)
                  fi;
                  # Rewind Management Rule
                  if not rule.rewind then
                     # Normal behavior: slide the tracking cursor completely past the newly inserted replacement string
                     local offset := size rule.replacement;
                     cursor +:= if offset > 0 then offset else 1 fi
                  fi;
                  # Break out of the inner rule testing loop immediately to apply changes and continue scanning
                  break
               fi
            fi
         fi
      od;
      # Linear Traversal Rule: If no rules match the text at the current cursor, step forward 1 character space
      cursor +:= not matched
   od;
   # Return the fully transformed final text sequence
   return buffer
end;
*/

local findmatch := proc(buf :: string, pos :: number, rules :: table) is  # new 7.12.7
   local slice := buf@@sub(pos);
   for i to size rules do
      local r := rules[i];
      if r.anchorstart and pos > 1 then next fi;
      local pat := r.pattern;
      if pat = '\0' or pat = '' then next fi;
      if r.phonetiQs and size pat = 1 and pat in '%()' then
         pat := '%' & pat
      fi;
      local s, e := slice@@find('^' & pat);
      if s = 1 then
         if r.anchorend and (pos + e - 1) <> size buf then next fi;
         return r, s, e
      fi
   od;
   return null
end;

aspell.norm := proc(word :: string, rules :: table) is  # changed 7.12.7
   local src := upper(word);
   local out := '';
   local i := 1;
   local rewinds := 0;
   while i <= size src do
      local rule, s, e := findmatch(src, i, rules);
      if rule <> null then
         local matchedstr := src@@sub(i, i + e - 1);
         local limit := rule.slicelimit or 0;
         local cutlength := size matchedstr;
         if 0 < limit < size matchedstr then
            cutlength := size matchedstr - limit
         fi;
         if cutlength < 1 then cutlength := 1 fi;
         # Follow-up priority check (Aspell followup = 1)
         #if not rule.phonetiQs and (limit > 0 or cutlength > 1) and i < size src then
         if not rule.phonetiQs and limit > 0 and i < size src then
            local nextrule := findmatch(src, i + 1, rules);
            if nextrule <> null and nextrule.priority >= rule.priority then
               # Current rule is preempted: drop current char (or apply 1-char rule if needed) and advance
               i +:= 1;
               next
            fi
         fi;
         local repl := rule.replacement;
         if repl = '_' then
            repl := ''
         elif not rule.phonetiQs and repl@@find('%*') then
            repl := repl@@gsub('%*', if i = 1 then 'A' else '' fi)
         fi;
         if rule.phonetiQs and strings.find(rule.pattern, '%(%[.-%]%)') then
            repl := strings.gsub(matchedstr, rule.pattern, repl)
         fi;
         if rule.doublecaret then
            return out & repl & procname(src@@sub(i + cutlength), rules)
         fi;
         if rule.rewind and rewinds < 50 then
            rewinds +:= 1;
            src := src@@sub(1, i - 1) & repl & src@@sub(i + cutlength)
         else
            rewinds := 0;
            out &:= repl;
            i +:= cutlength
         fi
      else
         # GNU Aspell phonet.cpp default: unmatched characters are silently dropped!
         i +:= 1
      fi
   od;
   # Collapse adjacent duplicate characters (Aspell collapse_result = 1)
   out := out@@gsub('(.)%1+', '%1');
   return out
end;


scope  # inject some `aspell` package functions into the global strings metatable
   if getmetatable :: procedure then  # protect against sandboxing
      local _mt := getmetatable('')..__index;
      # get the global strings metatable safely via `..` indexing
      if assigned _mt then
         for i, j in aspell do
            if i in {'check', 'norm', 'suggest'} then
               _mt[i] := j
            fi
         od
      fi
   fi
end;


