'0.', 1k);

mapm.lnPhi := mapm.xnumber(  # ln(Golden Ratio), ln(1.0 + sqrt(5.0))/2.0
'0.', 1k);

mapm.InvlnPhi := mapm.xnumber(  # inverse ln(Golden Ratio), 1/ln(1.0 + sqrt(5.0))/2.0
'2.', 1k);

mapm.EulerGamma := mapm.xnumber(  # Euler-Mascheroni constant
'.', 1k);

mapm.Zeta2 := mapm.xnumber(  # Pi*Pi/6 = Zeta(2)
'1.', 1k);

mapm.naught     := mapm.xnumber('0', 1k);
mapm.nought     := mapm.naught;
mapm.one        := mapm.xnumber('1', 1k);
mapm.two        := mapm.xnumber('2', 1k);
