# Complex Compartment

mapm.I := mapm.new(0, 1);

mapm.carctan2 := proc(y :: cnumber, x :: cnumber) is
   return when zero x and zero y with mapm.new(0, 0);
   return -mapm.I*ln((x + mapm.I*y)/sqrt(x*x + y*y))
end;


# Bitwise Operators

# taken and adapted from:
# https://stackoverflow.com/questions/2982729/is-it-possible-to-implement-bitwise-operators-using-integer-arithmetic
# by Durandal

# table used for shift operations
mapm.pow2tab := mapm.pow2tab or [];
mapm.bits    := mapm.bits or 64;
if empty mapm.pow2tab then
   for i from 0 to mapm.bits - 1 do
      mapm.pow2tab[i] := if i < mapm.bits - 1 then mapm.xipow(mapm.two, i) else -mapm.xipow(mapm.two, i) fi
   od
fi;

# mapm.xnumber @ [ from 0, 1, 2, 4, 8, 16, 32, 64, 128, 256, 512, 1024, 2048, 4096, 8192, 16384, -32768 ];  # 16 entries

/* Logical shift left (unsigned)
   Gemini AI on arithmetic left shift: "Logical left shift and arithmetic left shift are always the same
   because both operations move all bits to the left, discard the most significant bit (MSB), and insert
   a zero into the least significant bit (LSB) position. 6.1.4/5 */
mapm.xbshl := proc(a, shift :: nonnegint) is
   mapm.checknonnegint(a, true);
   return if shift > mapm.bits - 1 then mapm.naught else a*mapm.pow2tab[shift] fi
end;


# Logical shift right; 6.1.4/5
mapm.xbshr := proc(a, shift :: nonnegint) is
   mapm.checknonnegint(a, true);
   return if shift > mapm.bits - 1 then mapm.naught else a\mapm.pow2tab[shift] fi;
end;


# Bitwise negation, assuming the input represents a 32-bit unsigned integer, 6.1.5
mapm.xbnot := proc(x) is
   local r, e;
   if x :: number then x := mapm.xnumber(x) fi;
   mapm.checknonnegint(x, true);
   if size mapm.pow2tab < 32 then
      error('Error in `mapm.xbnot`: lookup table `mapm.pow2tab` too small.')
   fi;
   r := mapm.naught;
   e := if x = mapm.naught then -1 else floor(mapm.xtonumber(mapm.xlog2(x))) fi;
   for n from 0 to e do
      #local p := mapm.pow2tab[n];
      #local q := ((x \ p) % 2) + mapm.one;
      local p, q := mapm.bprep(x, n);
      q +:= mapm.one;
      r +:= p*(q % mapm.two)
   od;
   for n from e + 1 to 31 do
      r +:= mapm.pow2tab[n]
   od;
   return r
end;


# Factorial function using Spouge approximation, 6.4.5 u1,
# see: https://iczelia.net/posts/factorial-approx/
# by Kamila Szewczyk

local _factorial := mapm.xfactorial;

mapm.SpougeCoeffs := proc(a :: posint) is
   local e, a0, k0, k0m1, Digits, one, half;
   create local table t;
   Digits := mapm.xdigits();
   mapm.xdigits(a + 2);  # adding two suffices
   t[0] := sqrt(mapm.Pi2);
   one := mapm.one;
   half := mapm.half;
   for k to a - 1 do
      k0 := mapm.xnumber(k);
      a0 := mapm.xnumber(a);
      e := exp(-k0 + a0);
      k0m1 := k0 - one;
      t[k] := (-one)^(k0m1)/_factorial(k0m1)*mapm.xnumber(-k0 + a0)^(k0 - half)*e;
   od;
   mapm.xdigits(Digits);
   return t
end;

mapm.xfactorial := proc(z) is
   feature store;
   local Digits, f, s;
   z := mapm.xnumber(z);
   if integral(z) then
      return if mapm.xsign(z) < 0 then undefined else _factorial(z) fi
   fi;
   Digits := mapm.xdigits();
   if unassigned store[Digits] then
      store[Digits] := mapm.SpougeCoeffs(Digits)
   fi;
   # increasing xdigits does not give better results
   # Maple: f := (z) -> (z+Digits)^(z+1/2)*exp(-z-Digits) * (c[0] + sum(c[k]/(z+k), k=1 .. Digits-1));
   f := (z + Digits)^(z + mapm.half)*exp(-z - Digits);
   s := store[Digits, 0];
   for k to Digits - 1 do
      s +:= store[Digits, k]/(z + k)
   od;
   return f*s
end;


mapm.xgamma := proc(z) is  # 6.4.5 u2
   return mapm.xfactorial(z - mapm.one)
end;


# Psi aka Digamma function using Spouge approximation, 6.4.5 u2,
# see: https://iczelia.net/posts/factorial-approx/
# by Kamila Szewczyk

mapm.xpsi := proc(z) is
   feature store;
   local Digits, f, s0, s1, c, zpk, one, two;
   one, two := mapm.one, mapm.two;
   z := mapm.xnumber(z) - one;
   mapm.xisnegint(z) ? return undefined;  # 6.5.1 tweak
   Digits := mapm.xdigits();
   if unassigned store[Digits] then
      store[Digits] := mapm.SpougeCoeffs(Digits)
   fi;
   f := (one - two*Digits)/(two*(Digits + z)) + mapm.xln(Digits + z);
   s0, s1 := mapm.naught, store[Digits, 0];
   for k to Digits - 1 do
      zpk := z + k;  # this term will never be zero
      c := store[Digits, k];
      s0 +:= c/(zpk^two);
      s1 +:= c/zpk
   od;
   return f - s0/s1
end;


# inject bitwise metamethods for real MAPM numbers
scope
   if local get := registry{'get'}, get :: procedure then
      local _mt := [
         __bshl = mapm.xbshl,
         __bshr = mapm.xbshr,
         __bnot = mapm.xbnot,
      ];
      # insert the metamethods above (stored to _mt) to the internal registry metatable created in C
      if local mt := get('xnumber'), mt :: table then
         for i, j in _mt do
            rawset(mt, i, j)
         od
      fi
   fi
epocs;


# Backward-compatibility aliases
mapm.xapprox := mapm.approx;   # 6.5.16
mapm.xhypot4 := mapm.xcathet;  # 7.4.0
