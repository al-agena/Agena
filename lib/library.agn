create table xml.aux;

local starttag := proc(p, label, xattr) is
   local stack, newelement;
   stack := xml.getcallbacks(p).stack;
   newelement := [label = label, xattr = xattr];
   insert newelement into stack
end;


local endtag := proc(p, label) is
   local stack, element, level;
   stack := xml.getcallbacks(p).stack;
   element := purge(stack);
   assume(element.label = label);
   level := size(stack);
   insert element into stack[level]
end;


local text := proc (p, txt) is
   local stack, element, n;
   stack := xml.getcallbacks(p).stack;
   element := top(stack);
   n := size(element);
   if element[n] :: string then
      element[n] &:= txt
   else
      insert txt into element
   fi
end;


local rjmethods := [
   StartElement  = starttag,
   EndElement    = endtag,
   CharacterData = text,
   _nonstrict    = true,
];


xml.decode := proc(o) is
   local c, p, status, err;
   c := rjmethods;
   c.stack := [[]]
   p := xml.new(c);
   if o :: string then
      status, err := xml.parse(p, o);
      if not status then return null, err fi
   else
      for l in o do
         status, err := xml.parse(p, l);
         if not status then return null, err fi
      od
   fi;
   status, err := xml.parse(p);
   if not status then return null, err fi;
   xml.close(p);
   return c.stack[1, 1]
end


xml.aux.decodexml_convert := proc(v :: string) is  # Agena 1.6.1
   local r := tonumber(v);  # try to convert into a number or complex number
   case r
      of 'true'  -> r := true
      of 'false' -> r := false
      of 'fail'  -> r := fail
   esac;
   return r
end;


xml.aux.decodexml := proc(x, flag) is
   return when x :: string or x = null or x.label = null with x;  # 2.12.1
   local r, s, t, xlabel, tlabel, rxlabel, replace;
   replace := strings.replace;
   create table r;
   # traverse table and collect entries
   xlabel := x.label;
   for i in '-:.' do
      xlabel := strings.replace(xlabel, i, '_')
   od;
   r[xlabel] := xml.aux.decodexml(x[1]);  # x.label = XML tag of entry
   rxlabel := r[xlabel];
   if rxlabel = '\n' or rxlabel :: string and strings.isblank(rxlabel) then  # handle leading white spaces, Agena 1.8.0
      r[xlabel] := []
   fi;
   for j from 2 to size x - 2 do
      t := x[j];  # t is the next entry
      next when t = '\n' or t :: string and strings.isblank(t, true);  # handle leading white spaces, Agena 1.8.0
      tlabel := t.label;
      for i in '-:.' do
         tlabel := strings.replace(tlabel, i, '_')
      od;
      if r[xlabel, tlabel] :: string then  # is the already tag/value already in the collection and is the entry a string ?
         r[xlabel, tlabel] := [r[xlabel, tlabel]]  # convert entry into a table
         for i to size t - 2 do
            insert xml.aux.decodexml(t[i]) into r[xlabel, tlabel]
         od
      elif r[xlabel, tlabel] = null then  # tag is not yet in collection ?
         local tsize := size t;
         if tsize = 3 then  # only one entry ?
            r[xlabel, tlabel] := xml.aux.decodexml(t[1])
         else
            if r[xlabel] :: string and trim(strings.remove(r[xlabel], '\n')) = '' then
               error('Error in `xml.aux.decodexml`: cannot parse this.')
            fi;
            r[xlabel, tlabel] := [];
            for i to tsize - 2 do
               for m, n in xml.aux.decodexml(t[i]) do
                  if m :: integer and n :: string and strings.isblank(n, true) then next fi;  # 6.5.2, do not insert leading blanks
                  r[xlabel, tlabel, m] := xml.aux.decodexml(n)
               od
            od
         fi
      else  # tag/value already in the collection and in a table
         local o, u, loopflag;
         create table u;
         if unassigned(flag) then
            if unassigned(r[xlabel, tlabel, 1]) then  # XXX is table a dictionary ? Agena 1.8.0 really dirty fix, but which also prevents blank strings
               r[xlabel, tlabel] := [r[xlabel, tlabel]];
               flag := true  # do not create another table but insert data instead into the present table
            fi
         fi;
         loopflag := false;  # Agena 1.8.0 fix
         for i to size t - 2 do
            o := xml.aux.decodexml(t[i], flag);
            if o :: table then  # Agena 1.8.0 fix
               loopflag := true;
               for m, n in o do
                  u[m] := xml.aux.decodexml(n)
               od
            elif not strings.isblank(o, true) then  # 6.5.2, do not insert leading blanks
               insert o into r[xlabel, tlabel]
            fi
         od;
         if loopflag then
            insert u into r[xlabel, tlabel]
         fi
      fi
   od;
   return r
end;


xml.decodexml := proc(s :: string) is
   local L, err;
   s := strings.remove(s, '\n');  # 5.6.1 u1 fix
   L, err := xml.decode(s);
   unassigned(L) ? error('Error in `xml.decodexml`: ' & err & '.');  # 6.5.2 change
   return xml.aux.decodexml(L)
end;


xml.readxml := proc(fn :: string) :: table is
   local L, err;
   if not(os.exists(fn)) then
      error('Error in `xml.readxml`: file does not exist.')
   fi;
   L := io.readfile(fn, true);  # 6.5.2 tweak
   L, err := xml.decode(L);
   unassigned(L) ? error('Error in `xml.readxml`: ' & err & '.');  # 6.5.2 change
   return xml.aux.decodexml(L)
end;


