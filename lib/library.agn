/* Returns the fractional part of a longdouble, preserving the sign. 2.34.5 */
long.fraction := def x :: longdouble -> sign(x)*frac(x);

long.scalb := long.ldexp

begin
   create local table tbl;
   for k, v in long do  # 2.35.1 fix
      if v :: procedure and k[1] <> 'x' then
         tbl['x' & k] := v
      fi
   od;
   long := long union tbl;
   long.scalb := long.ldexp
end;

