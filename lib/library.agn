a copy of this software and associated documentation files (the
"Software"), to deal in the Software without restriction, including
without limitation the rights to use, copy, modify, merge, publish,
distribute, sublicense, and/or sell copies of the Software, and to
permit persons to whom the Software is furnished to do so, subject to
the following conditions:

The above copyright notice and this permission notice shall be
included in all copies or substantial portions of the Software.

THE SOFTWARE IS PROVIDED "AS IS", WITHOUT WARRANTY OF ANY KIND,
EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF
MERCHANTABILITY, FITNESS FOR A PARTICULAR PURPOSE AND
NONINFRINGEMENT. IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS
BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN
ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN
CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE
SOFTWARE.

Ported to Agena by a walz.
*/

create table json;  # create package table

json.nil := utils.udata('null');  # 5.1.5 change for better JSON `null' representation

local _strfind    := strings.find;
local _strtochars := strings.tochars;
local _strrepeat  := strings.repeat;
local _strformat  := strings.format;
local _strbyte    := strings.byte;

# checks for a JSON array, not an Agena array, so we can't use environ.attrib or tables.getsizes, patched 3.1.0
local procedure isarray(tbl) is
   local max, n, arraylen -> 0;
   for k, v in tbl do
      if k = 'n' and v :: number then
         arraylen := v;
         if v > max then max := v fi;
      else
         if k -: number or k < 1 or floor(k) <> k then
            return false
         fi;
         if k > max then max := k fi;
         n++
      fi
   od;
   if max > 10 and max > arraylen and max > 2*n then
      return false  # don't create an array with too many holes
   fi;
   return true, max
end;

local escapecodes := [
   "\"" = "\\\"", "\\" = "\\\\", "\b" = "\\b", "\f" = "\\f",
   "\n" = "\\n",  "\r" = "\\r",  "\t" = "\\t"
];

local procedure escapeutf8(uchar) is
   local value := escapecodes[uchar];
   if value then return value end
   local a, b, c, d := _strbyte(uchar, 1, 4);
   a, b, c, d := a or 0, b or 0, c or 0, d or 0;
   if a <= 0x7f then
      value := a
   elif 0xc0 <= a and a <= 0xdf and b >= 0x80 then
      value := (a - 0xc0) * 0x40 + b - 0x80
   elif 0xe0 <= a and a <= 0xef and b >= 0x80 and c >= 0x80 then
      value := ((a - 0xe0) * 0x40 + b - 0x80) * 0x40 + c - 0x80
   elif 0xf0 <= a and a <= 0xf7 and b >= 0x80 and c >= 0x80 and d >= 0x80 then
      value := (((a - 0xf0) * 0x40 + b - 0x80) * 0x40 + c - 0x80) * 0x40 + d - 0x80
   else
      return ''
   end;
   if value <= 0xffff then
      return _strformat("\\u%.4x", value)  # 2.6.1 patch
   elif value <= 0x10ffff then
      #encode as UTF-16 surrogate pair
      value := value - 0x10000;
      local highsur, lowsur := 0xd800 + int(value/0x400), 0xdc00 + (value % 0x400);
      return _strformat("\\u%.4x\\u%.4x", highsur, lowsur)  # 2.6.1 patch
   else
      return ''
   fi
end;

local procedure fsub(str, pattern, repl) is
   # gsub always builds a new string in a buffer, even when no match
   # exists. First using find should be more efficient when most strings
   # don't contain the pattern.
   if str -: string then error('Error: wrongly formatted code, near ' & tostring(str) & '.') fi;
   return if _strfind(str, pattern) then strings.gsub(str, pattern, repl) else str fi
end;

local procedure quotestring(value) is
   # based on the regexp "escapable" in https://github.com/douglascrockford/JSON-js
   value := fsub(value, '[%z\1-\31\"\\\127]', escapeutf8);
   if _strfind(value, '[\194\216\220\225\226\239]') then
      value := fsub(value, '\194[\128-\159\173]', escapeutf8);
      value := fsub(value, '\216[\128-\132]',     escapeutf8);
      value := fsub(value, '\220\143',            escapeutf8);
      value := fsub(value, '\225\158[\180\181]',  escapeutf8);
      value := fsub(value, '\226\128[\140-\143\168-\175]', escapeutf8);
      value := fsub(value, '\226\129[\160-\175]', escapeutf8);
      value := fsub(value, '\239\187\191',        escapeutf8);
      value := fsub(value, '\239\191[\176-\191]', escapeutf8)
   fi;
   return '\"' & value & '\"'
end;

# json.quotestring := quotestring  # do not expose

# locale independent num2str and str2num functions
local decpoint, numfilter;

local procedure updatedecpoint() is
   decpoint := strings.match(tostring(0.5), '([^05+])');
   # build a filter that can be used to remove group separators
   numfilter := "[^0-9%-%+eE" & strings.gsub(decpoint, '[%^%$%(%)%%%.%[%]%*%+%-%?]', '%%%0') & ']+'
end;

updatedecpoint();

local procedure num2str(num) is
   return strings.replace(fsub(tostring(num), numfilter, ''), decpoint, '.')
end;

local procedure str2num(str) is
   local num := tonumber(strings.replace(str, '.', decpoint));
   if not num then
      updatedecpoint();
      num := tonumber(strings.replace(str, '.', decpoint))
   fi;
   return num
end;

local procedure addnewline2(level, buffer, buflen) is
   buffer[++buflen] := '\n';
   buffer[++buflen] := _strrepeat('  ', level);
   return buflen
end;

local encode2;  # forward declaration

local procedure addpair(key, value, prev, indent, level, buffer, buflen, tbls, globalorder, state) is
   if key -: string and key -: number then
      return null, "type '" & type(key) & "' is not supported as a key by JSON."
   end;
   if prev then
      buffer[++buflen] := ','
   fi;
   if indent then
      buflen := addnewline2(level, buffer, buflen)
   fi;
   buffer[++buflen] := quotestring(key);
   buffer[++buflen] := ':';
   return encode2(value, indent, level, buffer, buflen, tbls, globalorder, state)
end;

local procedure appendcustom(res, buffer, state) is
   local buflen := state.bufferlen;
   if res :: string then
      buffer[++buflen] := res
   end;
   return buflen
end;

local procedure exception(reason, value, state, buffer, buflen, defaultmessage) is
   defaultmessage := defaultmessage or reason;
   local handler := state.exception;
   if not handler then
      return null, defaultmessage
   else
      state.bufferlen := buflen;
      local ret, msg := handler(reason, value, state, defaultmessage);
      if not ret then return null, msg or defaultmessage end;
      return appendcustom(ret, buffer, state)
   end
end;

encode2 := proc(value, indent, level, buffer, buflen, tbls, globalorder, state) is
   local valmeta := getmetatable(value);
   valmeta := valmeta :: table and valmeta;  # only tables
   # local valtojson := valmeta and valmeta.__tojson;
   local valtojson := valmeta and valmeta.__tostring;  # 5.1.5
   if valtojson then
      if tbls[value] then
         return exception('reference cycle', value, state, buffer, buflen)
      end;
      tbls[value] := true;
      state.bufferlen := buflen;
      local ret, msg := valtojson(value, state);
      if not ret then return exception('custom encoder failed', value, state, buffer, buflen, msg) end;
      tbls[value] := null;
      buflen := appendcustom(ret, buffer, state)
   elif value = null then
      buffer[++buflen] := 'null'
   elif value :: number then
      local s;
      if value <> value or value >= infinity or -value >= infinity then
         # this is the behaviour of the original JSON implementation
         s := 'null'
      else
         s := num2str(value)
      end;
      buffer[++buflen] := s
   elif value :: boolean then
      buffer[++buflen] := value and 'true' or 'false'
   elif value :: string then
      buffer[++buflen] := quotestring(value)
   elif value :: table then
      if tbls[value] then
         return exception('reference cycle', value, state, buffer, buflen)
      end;
      tbls[value] := true;
      level++;
      local isa, n := isarray(value);
      if n = 0 and valmeta and valmeta.__jsontype = 'object' then
         isa := false
      end;
      local msg;
      if isa then  # JSON array
         buffer[++buflen] := "[";
         for i to n do
            buflen, msg := encode2(value[i], indent, level, buffer, buflen, tbls, globalorder, state);
            if not buflen then return null, msg end;
            if i < n then
              buffer[++buflen] := ','
            end
         end;
         buffer[++buflen] := "]"
      else  # JSON object
         local prev := false;
         buffer[++buflen] := "{";
         local order := valmeta and valmeta.__jsonorder or globalorder;
         if order then
            local used := [];
            n := size order;
            for i to n do
               local k, v := order[i], value[k];
               if v <> null then
                  used[k] := true;
                  buflen, msg := addpair(k, v, prev, indent, level, buffer, buflen, tbls, globalorder, state);
                  prev := true  # add a separator before the next element
               end
            end;
            for k, v in value do
               if not used[k] then
                  buflen, msg := addpair(k, v, prev, indent, level, buffer, buflen, tbls, globalorder, state);
                  if not buflen then return null, msg end;
                  prev := true  # add a separator before the next element
               end
            end
         else  # unordered
            for k, v in value do
               buflen, msg := addpair(k, v, prev, indent, level, buffer, buflen, tbls, globalorder, state);
               if not buflen then return null, msg end;
               prev := true  # add a separator before the next element
            end
         end;
         if indent then
            buflen := addnewline2(level - 1, buffer, buflen)
         end;
         buffer[++buflen] := "}"
      end
      tbls[value] := null
   else
      return exception('unsupported type', value, state, buffer, buflen,
         'type \'' & type(value) & '\' is not supported by JSON.')
   end;
   return buflen
end;

procedure json.encode(value :: anything, state) is
   state := state or [];
   local oldbuffer := state.buffer;
   local buffer := oldbuffer or [];
   state.buffer := buffer;
   updatedecpoint();
   local ret, msg := encode2(value, state.indent, state.level or 0,
                     buffer, state.bufferlen or 0, state.tbls or [], state.keyorder, state);
   if not ret then
      error(msg, 2)
   elif oldbuffer = buffer then
      state.bufferlen := ret;
      return true
   else
      state.bufferlen := null;
      state.buffer := null;
      return strings.join(buffer)
   fi
end;

local procedure loc(str, where) is
   local line, pos, linepos := 1, 1, 0;
   do
      pos := _strfind(str, '\n', pos, true);
      if pos and pos < where then
         line++;
         linepos := pos;
         pos++
      else
         break
      fi
   od;
   return "line " & line & ", column " & (where - linepos)
end

local procedure unterminated(str, what, where) is
   return null, size(str) + 1, 'unterminated ' & what & ' at ' & loc(str, where)
end;

local procedure scanwhite(str, pos) is
   do
      pos := _strfind(str, '%S', pos);
      if not pos then return null end;
      local sub2 := str[pos to pos + 1];
      if sub2 = '\239\187' and str[pos + 2] = '\191' then
         # UTF-8 Byte Order Mark
         pos +:= 3
      elif sub2 = '//' then
         pos := _strfind(str, '[\n\r]', pos + 2);
         if not pos then return null end
      elif sub2 = '/*' then
         pos := _strfind(str, '*/', pos + 2);
         if not pos then return null end;
         pos +:= 2
      else
         return pos
      fi
   od
end;

local escapechars := [
   "\"" = "\"", "\\" = "\\", "/" = "/", "b" = "\b", "f" = "\f",
   "n" = "\n", "r" = "\r", "t" = "\t"
];

local procedure scanstring(str, pos) is
   local lastpos, buffer := pos + 1, [];
   do
      local nextpos := _strfind(str, '[\"\\]', lastpos);
      if not nextpos then
         return unterminated(str, 'string', pos)
      fi;
      if nextpos > lastpos then
         insert str[lastpos to nextpos - 1] into buffer
      fi;
      if str[nextpos] = '\"' then
         lastpos := nextpos + 1;
         break
      else
         local escchar, value := str[nextpos + 1], null;
         if escchar = 'u' then
            value := tonumber(str[nextpos + 2 to nextpos + 5], 16);
            if value then
               local value2;
               if 0xd800 <= value and value <= 0xdbff then
                  # we have the high surrogate of UTF-16. Check if there is a
                  # low surrogate escaped nearby to combine them.
                  if str[nextpos + 6 to nextpos + 7] = '\\u' then
                     value2 := tonumber(str[nextpos + 8 to nextpos + 11], 16);
                     if value2 and 0xdc00 <= value2 and value2 <= 0xdfff then
                        value := (value - 0xd800)*0x400 + (value2 - 0xdc00) + 0x10000
                     else
                        value2 := null  # in case it was out of range for a low surrogate
                     fi
                  fi
               fi;
               # value := value and unichar(value);
               value := value and strings.itouni(value);  # 5.1.5 change
               if value then
                  lastpos := nextpos + 6 + 6*assigned(value2)
               fi
            fi
         end;
         if not value then
            value := escapechars[escchar] or escchar;
            lastpos := nextpos + 2
         fi;
         insert value into buffer
      fi
   od;
   return strings.join(buffer), lastpos
end;

local scanvalue;  # forward declaration

local procedure scantable(what, closechar, str, startpos, nullval, objectmeta, arraymeta) is
   local len, tbl, n, pos := size str, [], 0, startpos + 1;
   setmetatable(tbl, if what = 'object' then objectmeta else arraymeta fi);
   do
      local val1, err, chr;
      pos := scanwhite(str, pos);
      if not pos then return unterminated(str, what, startpos) end;
      chr := str[pos];
      if chr = closechar then return tbl, pos + 1 fi;
      val1, pos, err := scanvalue(str, pos, nullval, objectmeta, arraymeta);
      if err then return null, pos, err end;
      pos := scanwhite(str, pos);
      if not pos then return unterminated(str, what, startpos) end;
      chr := str[pos];
      if chr = ':' then
         local val2;
         if val1 = null then
            return null, pos, 'cannot use null as table index (at ' & loc(str, pos) & ')'
         fi;
         pos := scanwhite(str, pos + 1);
         if not pos then return unterminated(str, what, startpos) end;
         val2, pos, err := scanvalue(str, pos, nullval, objectmeta, arraymeta);
         if err then return null, pos, err end;
         tbl[val1] := val2;
         pos := scanwhite(str, pos);
         if not pos then return unterminated(str, what, startpos) end;
         chr := str[pos]
      else
         insert val1 into tbl
      fi;
      if chr = ',' then
         pos++
      fi
   od
end;

scanvalue := proc(str, pos, nullval, objectmeta, arraymeta) is
   pos := pos or 1;
   pos := scanwhite(str, pos);
   if not pos then
      return null, size(str) + 1, 'no valid JSON value (reached the end)'
   end;
   local chr := str[pos];
   if chr = "{" then
      return scantable('object', '}', str, pos, nullval, objectmeta, arraymeta)
   elif chr = "[" then
      return scantable('array', ']', str, pos, nullval, objectmeta, arraymeta)
   elif chr = "\"" then
      return scanstring(str, pos)
   else
      local pstart, pend := _strfind(str, '^%-?[%d%.]+[eE]?[%+%-]?%d*', pos);
      if pstart then
         local num := str2num(str[pstart to pend]);
         if num then
            return num, pend + 1
         fi
      fi;
      pstart, pend := _strfind(str, '^%a%w*', pos);
      if pstart then
         local name := str[pstart to pend];
         if name = 'true' then
            return true, pend + 1
         elif name = 'false' then
            return false, pend + 1
         elif name = 'null' then
            return nullval, pend + 1
         fi
      fi;
      return null, pos, 'no valid JSON value at ' & loc(str, pos)
   end
end;

local procedure optionalmetatables(?) is
   if nargs > 0 then
      return op(?)
   else
      return [__jsontype = 'object'], [__jsontype = 'array']
   end
end;

procedure json.decode(str :: string, pos, nullval, ?) is
   pos := pos or 1;  # 5.1.5 hotfix for JSON `null' in the input string str
   nullval := nullval or json.nil;  # ditto
   local objectmeta, arraymeta := optionalmetatables(op(?));
   return scanvalue(str, pos, nullval, objectmeta, arraymeta)
end;


##############################################################################################
# regex package functions                                                                    #
##############################################################################################

local _origfind, _origmatch := regex.find, regex.match;

regex.find := proc(?) is  # 3.5.3, 3 times faster than original C `regex.find`
   feature store;
   local s := ?[2];
   if s :: string then  # compile internal regex representation for search pattern and put it into the store
      local p := store[s];
      if p then  # do not compute again and save a lot of time and prevent out-of-memory errors
         ?[2] := p
      else
         store[s], ?[2] -> regex.new(s)
      fi
   fi;
   return _origfind(op(?))
end;


regex.match := proc(?) is  # 3.5.3, 3 times faster than original C `regex.match`
   feature store;
   local s := ?[2];
   if s :: string then  # compile internal regex representation for search pattern and put it into the store
      local p := store[s];
      if p then  # do not compute again and save a lot of time and prevent out-of-memory errors
         ?[2] := p
      else
         store[s], ?[2] -> regex.new(s)
      fi
   fi;
   return _origmatch(op(?))
end;


##############################################################################################
# llist package functions                                                                    #
##############################################################################################

begin
   if local get := registry{'get'}, get :: procedure then  # prevent errors at initialisation in case package has been excluded in a sandbox
      # insert metamethods written in Agena to internal registry metatable created in C
      local pp := proc(l, listname, iterator) is
         local c, r, sll, f, s;
         c, r, sll := 1, '', size l;
         create seq s(10);
         if zero sll then return listname & '()' fi;
         f := iterator(l);
         while c <= sll do
            insert tostring(f()) into s;
            if everyth(c, 10) or c = sll then
               r &:= strings.join(s, ', ') & ', ';
               s := null;
               create seq s(10)
            fi;
            c++
         od;
         return listname & '(' & r[1 to -3] & ')'
      end;
      local _mt := [
         __tostring = proc(l) is
            if l :: 'llist' then
               return pp(l, 'llist', llist.iterate);
            elif l :: 'dlist' then
               return pp(l, 'dlist', dlist.iterate);
            else
               error('Error, invalid list structure')
            fi
         end
      ];
      if local mt := get('llist'), mt :: table then
         for i, j in _mt do
            rawset(mt, i, j)
         od
      fi;
      if mt := get('dlist'), mt :: table then
         for i, j in _mt do
            rawset(mt, i, j)
         od
      fi
   fi
end;


ulist.addnewnode := proc(ul, pos) is  # add new node at given position in linked list
   local status := ul[0];
   llist.put(ul, pos, seq());
   status.node++;
   put(status.sizes, pos, 0)
end;


# Works like llist.append: add to tail.
ulist.append := proc(ul, ?) is
   ulist.checkulist(ul);
   local status, node, fill, ll := ul[0];
   node, nodesizes, fill := status.node, status.sizes, status.fill;
   ll := ulist.getllist(ul, node);
   for value in ? do
      if nodesizes[node] >= status.nodesize * fill then  # create new node
         inc node;
         ulist.addnewnode(ul, node);
         ll := ulist.getllist(ul, node)
      fi;
      insert value into ll;
      nodesizes[node]++
   od
end;


# Works like llist.put.
ulist.put := proc(ul, pos :: integer, value) is
   ulist.checkulist(ul);
   local node, newpos, status, nodesizes, fill;
   status := ul[0];
   nodesizes, fill := status.sizes, status.fill;
   node, newpos := ulist.getindices(ul, pos);
   if unassigned node then
      pos > sumup(nodesizes) + 1 ? error('Error in `ulist.put`: index ' & pos & ' is out of range.');
      ulist.append(ul, value);
      return
   fi;
   put(ulist.getllist(ul, node), newpos, value);  # insert value into existing node
   nodesizes[node]++;
   if nodesizes[node] > status.nodesize * fill then  # current node is `full` ? 2.15.3 patch
      local formernode := ulist.getllist(ul, node);
      inc node;
      # check whether next node has enough free slots
      local ll := ulist.getllist(ul, node);
      if nodesizes[node] and nodesizes[node] < status.nodesize * fill then  # 2.15.3 patch
         put(ll, 1, pop formernode);  # insert last value of former node into next node
         nodesizes[node]++;
         nodesizes[node - 1]--
      else  # create new node
         ulist.addnewnode(ul, node);
         ll := ulist.getllist(ul, node);
         for i to nodesizes[node - 1] * fill do  # move right half of former node into new node
            ll[i] := pop formernode
         od;
         dec i;
         reverse(ll);
         nodesizes[node] := i;
         nodesizes[node - 1] -:= i
      fi
   fi
end;


# Works like llist.prepend.
ulist.prepend := proc(ul, ?) is
   ulist.checkulist(ul);
   for value in ? do
      ulist.put(ul, 1, value)
   od
end;


# Works like llist.purge.
ulist.purge := proc(ul, pos :: integer) is
   ulist.checkulist(ul);
   local node, newpos, status, nodesizes, ll, item;
   status := ul[0];
   nodesizes := status.sizes;
   node, newpos := ulist.getindices(ul, pos);
   unassigned node ? error('Error in `ulist.purge`: index ' & pos & ' is out of range.');
   ll := ulist.getllist(ul, node);
   item := ll[newpos];
   if item then  # remove element from sequence but only if it exists
      purge(ll, newpos);
      nodesizes[node]--;
      if zero(nodesizes[node]) and status.node > 1 then  # remove empty node, but keep at least first node
         llist.purge(ul, node);   # delete node
         purge(nodesizes, node);  # remove its count entry in sizes table
         status.node--            # decrement number of total nodes
      fi
   fi;
   return item
end;


# Like llist.iterate.
ulist.iterate := proc(ul, n, p, pushidx) is
   ulist.checkulist(ul);
   local node, status, sizes, f, c, s, idx;
   n := optint(n, 1, 2, 'ulist.iterate');     # start with index n, defaulting to 1
   p := optposint(p, 1, 3, 'ulist.iterate');  # step size
   pushidx := optboolean(pushidx, false, 4, 'ulist.iterate');  # push index and value
   return proc() is
      if unassigned node then  # get up-to-date status and size info on invocation, 7.1.1
         c := 1; idx := 0;
         status := ul[0];
         sizes := status.sizes;
         node := ulist.getindices(ul, n);
         unassigned node ? return null;
         f := llist.iterate(ul, node);  # 2.15.4 tuning
         s := f();  # 2.15.4 tuning
      fi;
      if s and c > sizes[node] then  # fetch next node sequence; 2.15.4 tuning
         c -:= sizes[node];
         inc node;
         s := f();
      fi;
      if s and c <= sizes[node] then  # 2.15.4 tuning
         inc c, p;
         if pushidx then
            return ++idx, s[c - p]
         else
            return s[c - p]
         fi
      else
         pushidx ? node := null;  # reset & make the iterator reload status data with the next call, 7.1.1
         return null
      fi
   end
end;


local _ulistnew := ulist.new;

ulist.new := proc(?) is
   local r := _ulistnew(op(?));
   local mt := getmetatable(r);
   mt.__iter := ulist.iterate(r, 1, 1, true);
   return r, mt.__iter
end;


# Introsort, etc. on ulists is by far too slow, even in C, so here is the brute force method
ulist.sort := proc(ul :: ulist, f) is
   local status, newseq, s, sizes;
   status, newseq := ul[0], seq();
   sizes := status.sizes;
   # from last node sequence to first one do
   for i from status.node downto 1 do
      s := ulist.getllist(ul, i);
      # for each node sequence do (bulk copying using `union` creates out-of-memory errors for internally,
      # sequences are duplicated before sometimes being gc'ed)
      for j from sizes[i] downto 1 do      # empty it and put its elements into newseq
         insert purge(s, j) into newseq    # w/o moving the other elements in the node seq
      od;
      i <> 1 ? llist.purge(ul, i);  # delete node, but leave empty node #1
      purge(sizes, i)  # remove its count entry in sizes table
   od;
   environ.gc()
   # reset defaults
   status.node := 1;
   status.sizes := [0];
   sort(newseq, f);
   # fill list with sorted items
   for i from size newseq downto 1 do      # and at the same time shrink newseq
      ulist.prepend(ul, purge(newseq, i))  # w/o moving items around in it
   od
end;


# Converts the contents of a ulist to a formatted string that can be output at the prompt.
ulist.tostring := proc(ul) is
   ulist.checkulist(ul);
   local f, m;
   if empty ul then return 'ulist()' fi;
   f := ulist.iterate(ul);
   m := memfile.charbuf();
   while c := f() do
      memfile.append(m, tostringx(c), ', ')
   od;
   return 'ulist(' & memfile.substring(m, 1, -3) & ')'
end;


# add further metamethods
begin
   if local get := registry{'get'}, get :: procedure then
      local _mt := [
         __tostring = ulist.tostring,
         __eq       = ulist.isequal,
      ];
      # insert metamethods written in Agena to internal registry metatable created in C
      if local mt := get('ulist'), mt :: table then
         for i, j in _mt do
            rawset(mt, i, j)
         od
      fi
   fi
end;


##############################################################################################
# numarray package functions                                                                 #
##############################################################################################

create table numarray.aux;

# The I/O Compartment ########################################################################

numarray.aux.readvalues := proc(fh, a, sizevalue, datatype, buffersize) is
   local r, c, d, sizer, t, offset;
   c, d := 0, 1;
   if buffersize -: number or isnonposint(buffersize) then
      buffersize := environ.kernel('buffersize')
   fi;
   offset := buffersize % sizevalue;
   if offset <> 0 then  # buffersize is not a multiple of sizeof(datatype) ?
      buffersize +:= offset
   fi;
   if datatype in {'uint64', 'int64'} then  # 6.3.5 extension
      local buf, sbuf;
      buf := numarray.readuint32(fh);
      sbuf := size buf;
      size a < sbuf\2 ? numarray.resize(a, sbuf\2);  # to make indexing work correctly
      for i to sbuf - 1 by 2 do  # (u)int64's are stored in Little Endian order
         a[d++] := ints.setwords(buf[i + 1], buf[i], datatype == 'int64')
      od
   else
      do
         r := numarray.read(fh, buffersize);
         if assigned r then
            sizer := size r;
            if sizer % sizevalue <> 0 then  # this does not seem to be a file with doubles
               error('Error in `numarray.read' & datatype & 's`: file size is invalid.')
            fi;
            c +:= sizer \ sizevalue;
            numarray.resize(a, c);
            case datatype
               of 'uchar' then
                  numarray.include(a, d, r);
                  d +:= size r
               of 'double', 'int32', 'uint32', 'ushort', 'longdouble' then
                  for i to sizer by sizevalue do
                     create sequence t(sizevalue);
                     for j to sizevalue do     # read sizeof(datatype) bytes
                        t[j] := r[i + j - 1]
                     od;
                     a[d++] := bytes.tonumber(t)  # convert to number or long double ud, 2.14.9, 2.15.5 fix
                  od
               of 'cdouble' then
                  local zr, zi;
                  for i to sizer by sizevalue do
                     create sequence t(sizevalue\2);
                     for j to sizevalue\2 do   # read sizeof(datatype) bytes
                        t[j] := r[i + j - 1]
                     od;
                     zr := bytes.tonumber(t);  # convert to number, real part
                     for j from sizevalue\2 + 1 to sizevalue do   # read sizeof(datatype) bytes
                        t[j - sizevalue\2] := r[i + j - 1]
                     od;
                     zi := bytes.tonumber(t);  # convert to number, imaginary part, 4.9.5 fix
                     a[d++] := zr!zi  # convert to complex number
                  od
               else
                  error('Error in `numarray.aux.readvalues`: unknown data type.')
               esle
            esac
         else
            break # loop
         fi
      od
   fi;
   return if d = 1 then null else a fi  # return array, or null if file size is zero
end;


numarray.readuchars := proc(fh :: userdata, buffersize) is
   return numarray.aux.readvalues(fh,
      numarray.uchar(0), environ.system().Ctypes['char'], 'uchar', buffersize)  # 2.15.5 fix
end;


/* Reads all the numeric data from the file denoted by its filehandle fh and returns a numarray of C doubles.

The file should be opened before with `binio.open` and should finally be closed with `binio.close`.

The function is written in Agena (see lib/numarray.agn). */

numarray.readdoubles := proc(fh :: userdata, buffersize) is
   return numarray.aux.readvalues(fh,
      numarray.double(0), environ.system().Ctypes['double'], 'double', buffersize)  # 2.15.5 fix
end;


numarray.readcdoubles := proc(fh :: userdata, buffersize) is
   return numarray.aux.readvalues(fh,
      numarray.cdouble(0), environ.system().Ctypes['complexdouble'], 'cdouble', buffersize)
end;


numarray.readintegers := proc(fh :: userdata, buffersize) is
   return numarray.aux.readvalues(fh,
      numarray.int32(0), environ.system().Ctypes['int32_t'], 'int32', buffersize)  # 2.15.5 fix
end;


numarray.readuint32 := proc(fh :: userdata, buffersize) is  # 2.21.1
   return numarray.aux.readvalues(fh,
      numarray.uint32(0), environ.system().Ctypes['uint32_t'], 'uint32', buffersize)
end;


numarray.readushorts := proc(fh :: userdata, buffersize) is  # 2.18.2
   return numarray.aux.readvalues(fh,
      numarray.ushort(0), environ.system().Ctypes['uint16_t'], 'ushort', buffersize)
end;


numarray.readlongdoubles := proc(fh :: userdata, buffersize) is  # 2.35.0
   return numarray.aux.readvalues(fh,
      numarray.longdouble(0), environ.system().Ctypes['longdouble'], 'longdouble', buffersize)
end;


numarray.readuint64 := proc(fh :: userdata, buffersize) is  # 5.3.5
   return numarray.aux.readvalues(fh,
      numarray.uint64(0), environ.system().Ctypes['uint32_t'], 'uint64', buffersize)
end;


numarray.readint64 := proc(fh :: userdata, buffersize) is  # 5.3.5
   return numarray.aux.readvalues(fh,
      numarray.int64(0), environ.system().Ctypes['uint32_t'], 'int64', buffersize)
end;


# The Introsort Compartment, 4.11.4 ##########################################################

/* Based on the introsort algorithm as published in Niklaus Wirth's book `Algorithms and Data
   Structures` (for Oberon), extended to optionally sort a portion of an array only.

   Taken from tools_introsort in agnhlps.c. 4.11.4

   "Introsort is a hybrid sorting algorithm that provides both fast average performance and
   (asymptotically) optimal worst-case performance. It begins with quicksort and switches to
   heapsort when the recursion depth exceeds a level based on (the logarithm of) the number
   of elements being sorted. (Wikipedia, retrieved 2014-May-06.)" */

# All this tuning does not speed up at all, we do it anyway:
local ltdsift := proc(L, R, offset, g, h) is
   local i, j, x;
   i := L; j := 2*i + 1 - offset; x := g(i);
   if j < R and g(j) < g(j + 1) then j++ fi;
   while j <= R and x < g(j) do
      h(i, g(j)); i := j; j := 2*j + 1 - offset;
      if j < R and g(j) < g(j + 1) then j++ fi
   od;
   h(i, x)
end;

numarray.aux.ltheapsort := proc(a, l, r) is
   local L, R, g, h;
   g, h := numarray.geti(a), numarray.seti(a);
   L := l + (r - l + 1)\2; R := r;
   while L > l do
      L--;
      ltdsift(L, R, l, g, h)
   od;
   while R > l do
      a[l], a[R] := g(R), g(l);
      R--;
      ltdsift(L, R, l, g, h)
   od
end;

numarray.aux.ltisort := proc(v, l, r, depth, threshold, g) is
   local i, last;
   return when l >= r;
   depth++;
   if depth = threshold then
      numarray.aux.ltheapsort(v, l, r)
   else
      if unassigned g then g := numarray.geti(v) fi;
      v[l], v[(l + r)\2] := g((l + r)\2), g(l);
      last := l;
      for i from l + 1 to r do
         if g(i) < g(l) then
            last++;
            v[last], v[i] := g(i), g(last)
         fi
      od;
      v[l], v[last] := g(last), g(l);
      procname(v, l, last - 1, depth, threshold, g);
      procname(v, last + 1, r, depth, threshold, g)
   fi
end;

local dsift := proc(f, L, R, offset, g, h) is
   local i, j, x;
   i := L; j := 2*i + 1 - offset; x := g(i);
   if j < R and f(g(j), g(j + 1)) then j++ fi;
   while j <= R and f(x, g(j)) do
      h(i, g(j)); i := j; j := 2*j + 1 - offset;
      if j < R and f(g(j), g(j + 1)) then j++ fi
   od;
   h(i, x)
end;

numarray.aux.heapsort := proc(f, a, l, r) is
   local L, R, g, h;
   g, h := numarray.geti(a), numarray.seti(a);
   L := l + (r - l + 1)\2; R := r;
   while L > l do
      L--;
      dsift(f, L, R, l, g, h)
   od;
   while R > l do
      a[l], a[R] := g(R), g(l);
      R--;
      dsift(f, L, R, l, g, h)
   od
end;

numarray.aux.isort := proc(f, v, l, r, depth, threshold, g) is
   local i, last;
   return when l >= r;
   depth++;
   if depth = threshold then
      numarray.aux.heapsort(f, v, l, r);
   else
      if unassigned g then g := numarray.geti(v) fi;
      v[l], v[(l + r)\2] := g((l + r)\2), g(l);
      last := l;
      for i from l + 1 to r do
         if f(g(i), g(l)) then
            last++;
            v[last], v[i] := g(i), g(last)
         fi
      od;
      v[l], v[last] := g(last), g(l);
      procname(f, v, l, last - 1, depth, threshold, g);
      procname(f, v, last + 1, r, depth, threshold, g)
   fi
end;

numarray.sort := proc(v :: {listing, userdata}, ?) is
   local s, threshold, f, l, r;
   if nargs > 1 then
      if ?[1] :: pair and left(?[1]) :: nonzeroint and right(?[1]) :: nonzeroint then
         l, r := op(?[1])
      elif ?[2] :: pair and left(?[2]) :: nonzeroint and right(?[2]) :: nonzeroint then
         l, r := op(?[2])
      fi;
      if   ?[1] :: procedure then f := ?[1]
      elif ?[2] :: procedure then f := ?[2]
      fi;
   fi;
   if s := size v, zero s then return fi;
   unassigned l ? l := 1;
   unassigned r ? r := s;
   l := utils.posrelat(l, s); r := utils.posrelat(r, s);
   if l > r or r > s then
      error('Error in `numarray.sort`: the borders ' & l & ', ' & r & ' are invalid.')
   fi;
   threshold := 2*ilog2(r - l + 1);
   if f :: procedure then  # sort using a user-defined order
      numarray.aux.isort(f, v, l, r, 0, threshold)
   elif l = 1 and r = s then  # sort whole array in ascending order
      numarray.introsort(v)
   else  # sort parts of array in ascending order
      numarray.aux.ltisort(v, l, r, 0, threshold)
   fi
end;

# Miscellaneous ##############################################################################

/* The function creates a new number array and fills it with values. `what`, a string,
   indicates the type of array to create - either 'double', 'cdouble', 'uchar', 'ushort',
   'uint32' or 'int32'.

   In the first form, the array is filled with all the (complex) numbers in table, sequence or
   register obj.

   In the second form, n denotes the number of slots to allocate and f denotes a function that
   is called with integers from 1 to n and fills the array with its numeric result. */
numarray.new := proc(what :: string, ?) is
   local r, val, n, f, g;
   if ?[1] :: listing then
      n, f := size ?[1], identity;
   elif ?[1] :: posint and ?[2] :: procedure then
      n, f := op(?)
   else
      error('Error in `numarray.new`: wrong number (or type) of arguments.')
   fi;
   case what
      of 'double' then
         r := numarray.double(n)
      of 'cdouble' then
         r := numarray.cdouble(n)
      of 'uchar' then
         r := numarray.uchar(n)
      of 'ushort' then
         r := numarray.ushort(n)
      of 'uint32' then
         r := numarray.uint32(n)
      of 'int32' then
         r := numarray.int32(n)
      of 'uint64' then  # 6.3.1 extension
         r := numarray.uint64(n)
      of 'int64' then  # 6.3.1 extension
         r := numarray.int64(n)
      of 'longdouble' then  # 6.3.1 extension
         r := numarray.longdouble(n)
      else
         error('Error in `numarray.new`: type `' & what & '` is unknown or unsupported.')
      esle
   esac;
   g := numarray.seti(r);
   if ?[1] :: listing then  # 4.11.7 fix
      local c := 0;
      for val in ?[1] do
         if val :: {number, complex} or val :: 'ints' or val :: 'longdouble' then  # 6.3.1 extension
            g(++c, val)
         else
            error('Error in `numarray.new`: function call did not result in a number.')
         fi
      od
   else
      for i to n do
         if val := f(i), val :: {number, complex} then
            g(i, val)
         elif val :: 'ints' or val :: 'longdouble' then  # 6.3.1 extension
            g(i, val)
         else
            error('Error in `numarray.new`: function call did not result in a number.')
         fi
      od
   end;
   return r
end;


numarray.binsearch := proc(u :: double, val :: number, option) is  # this is quite slow
   local m, l, r;
   l, r := 1, size u;
   while l < r do
      m := (l + r) \ 2;
      if u[m] < val then
         l := m + 1
      else
         r := m
      fi
   od;
   return if option <> null then u[r] = val else approx(u[r], val) fi  # 6.5.14 fix
end;


##############################################################################################
# lookup package functions                                                                   #
##############################################################################################

lookup.map := proc(f :: procedure, a, ?) is
   lookup.checktable(a);
   local t := lookup.gettable(a);
   if t :: table then
      for value in t do
         map(f, value, op(? union ['inplace':true]))
      od
   else
      error('Error in `lookup.map`: invalid argument.')
   fi;
   return t
end;


lookup.subs := proc(?) is
   if nargs < 2 then
      error('Error in `lookup.subs`: need at least two arguments.')
   fi;
   lookup.checktable(?[nargs]);
   local t := lookup.gettable(?[nargs]);
   if t :: table then
      for value in t do
         subs(op(?[1 to nargs - 1] union [value] union ['inplace':true]))
      od
   else
      error('Error in `lookup.subs`: invalid argument.')
   fi;
   return t
end;


##############################################################################################
# hashes package functions                                                                   #
##############################################################################################

/* Returns the mean number of collisions, number of total slots (occupied or free), and the time it took to run the procedure;
   If if returnbag is true, the hashing table (a bag) returned, as well. */

hashes.collisions := proc(s :: {sequence, table}, f :: procedure, factor, iters, returnbag) is
   local slots, b, p, q, t0, t1;
   slots := size s;
   not numtheory.isprime(slots) ? slots := numtheory.nextprime(slots);
   iters := optposint(iters, 1, 3, 'hashes.collisions');
   factor := optpositive(factor, 2, 4, 'hashes.collisions');
   mul slots, factor;
   slots := ceil(slots);
   t0 := time();
   to iters do
      b := bags.new();
      for i in s do
         if f <> hashes.md5 then
            bags.include(b, f(i, slots))
         else
            bags.include(b, f(i))
         fi
      od
   od;
   t1 := time();
   # p: number of all unique elements in the bag, q: accumulated number of all occurrences of these elements
   p, q := bags.attrib(b);
   if returnbag then
      return q/p, slots, t1 - t0, b
   else
      return q/p, slots, t1 - t0
   fi
end;


/* Computes the digit sum of the integer x to the base n and returns an integer. n is 10 by default.
   If x is negative, the result is negative, i.e. -hashes.digitsum(abs(x), n) is returned.
   The function is written in Agena and included in the lib/hashes.agn file. */
hashes.digitsum := proc(x :: number, b) is  # 2.10.4
   local s, f, sgn;
   s, b, sgn := 0, optposint(b, 10), 1;
   if x < 0 then
      sgn := -1;
      x := -x
   fi;
   for i from 0 to entier log(x, b) do
      f := b**i;
      # sum(1/(b^n)*(x%b^(n+1)-x%b^n), n=0..entier log(x, b)), see: https://en.wikipedia.org/wiki/Digit_sum
      inc s, (recip f) * (x % (f*b) - x % f)
   od;
   return sgn*s
end;


##############################################################################################
# heaps package functions                                                                    #
##############################################################################################

# --------------------------------------------------------------------------------------------------------------------------
# AVL tree
# --------------------------------------------------------------------------------------------------------------------------

/* The factory returns an iterator that with each call returns a key~value pair from the AVL tree, in ascending order
   of its indices. */
avl.iterate := proc(a :: avl) is
   local indices, key := avl.indices(a), 1;
   local length := size indices;
   return proc() is
      key > length ? return null;
      local idx := indices[key++];
      local val := avl.find(a, idx);
      return idx, val
   end
end;

# --------------------------------------------------------------------------------------------------------------------------
# Skew heap
# Copyright (c) 2008-2011 Incremental IP Limited.
# --------------------------------------------------------------------------------------------------------------------------

create table skew;
create table skew.aux;

skew.aux.directdelete := false;  # directly delete child nodes with skew.include and skew.remove

# -- internal functions ----------------------------------------------------------------------------------------------------

local procedure skew_merge (h, a, b) is
   local cmp, head;
   cmp := h.comparison;
   head := h;
   if not b then
      head.l := a
   else
      while a do
         if cmp(a.key, b.key) then       # a is less (or higher priority) than b
            head.l := a;                 # the lesser tree goes on the left
            head := a;                   # and we work on that in the next round
            a := head.r;                 # by merging its right side with b
            head.r := head.l             # and we move the left side to the right
         else
            head.l := b;
            head := b;
            a, b := head.r, a;
            head.r := head.l
         fi
      od;
      head.l := b
   fi
end;

local procedure skew_removeemptybranch (h, r) is
   if h.l and size h.l = 0 then h.l := null fi;
   if h.r and size h.r = 0 then h.r := null fi
end;

local procedure skew_nextbranch (h, branch) is
   local head, new;
   h = null ? return null;
   head := rawget(h, 'l');  # use rawget, otherwise we won't iterate !
   head = null ? return null;
   new := [ comparison = h.comparison, length = rawget(h, 'length'), l = rawget(head, branch) ];
   settype(new, 'skew');
   return new
end;

# newvalue must be non-null if given, the function cannot delete nodes; added 2.27.6
local procedure skew_aux_findorreplace (h, what, key, newvalue, mode) is
   if local head := rawget(h, 'l') then
      local r;
      settype(head, 'skew');
      if head[what] = key then
         r := if what = 'key' then head.value else head.key fi;
         if assigned newvalue and newvalue <> null then
            head.value := newvalue  # replace old with new value at existing key
         elif mode = 'write' then   # remove key~value pair and
            r := [];  # collect all the data in the child nodes and re-insert it from the top later on
            head.key, head.value -> null;
            for i in skew.indices(head) do
               r[i] := procname(h, 'key', i)
            end;
            for i in skew.indices(head, 'r') do
               r[i] := procname(h, 'key', i)
            end;
            # calling skew_merge produces only a heap with a lot of empty nodes
            if unassigned head.r then
               rawset(h, 'l', null)
            fi
         fi;
         return r
      fi
      # recursive instead iterative approach in order to not destroy the heap during traversal
      r := procname(skew_nextbranch(h, 'l'), what, key, newvalue, mode);
      mode ? skew_removeemptybranch(head, r);
      if r then return r end;
      r := procname(skew_nextbranch(h, 'r'), what, key, newvalue, mode);
      mode ? skew_removeemptybranch(head, r);
      return r
   end;
   return null
end;

procedure skew.get (h, k) is  # 4.3.0
   return skew_aux_findorreplace(h, 'key', k)
end;


procedure skew.find (h, v) is  # 4.3.0
   return skew_aux_findorreplace(h, 'value', v)
end;


# -- metamethods -----------------------------------------------------------------------------------------------------------

procedure skew.aux.mt_empty (h :: skew) is
   return unassigned h.l or size h = 0  # extended 2.27.6 u1
end;

procedure skew.aux.mt_filled (h :: skew) is
   return assigned h.l or size h <> 0  # extended 2.27.6 u1
end;

procedure skew.aux.mt_in (key :: anything, h :: skew) is
   return skew_aux_findorreplace(h, 'value', key, null, 'read') <> null
end;

procedure skew.aux.mt_notin (key :: anything, h :: skew) is
   return skew_aux_findorreplace(h, 'value', key, null, 'read') = null
end;

procedure skew.aux.mt_size (h :: skew) is
   return h.length
end;

# -- skew heap construction ------------------------------------------------------------------------------------------------

local procedure default_comparison (k1, k2) is
   return k1 and type k1 = type k2 and k1 < k2
end;


/* Creates an empty skew heap with the default comparison method for various operations the `less than` relation, i.e.
   <: k1, k2 -> k1 and type k1 = type k2 and k1 < k2 :>. You might pass another comparison function to be used.
   Extended 4.3.0 */
procedure skew.new (comparison) is
   local h, mt;
   h := [ comparison = comparison or default_comparison, length = 0 ];
   mt := [
      __empty  = skew.aux.mt_empty,
      __filled = skew.aux.mt_filled,
      #__index  = skew.aux.findorreplace,
      __size   = skew.aux.mt_size,
      __in     = skew.aux.mt_in,
      __notin  = skew.aux.mt_notin,
      include  = skew.include,
      remove   = skew.remove,
      find     = skew.find,
      get      = skew.get,
      indices  = skew.indices,
      entries  = skew.entries,
      reorder  = skew.reorder
   ];
   mt.__index := mt;  # register methods
   setmetatable(h, mt, 'skew');
   return h
end;

# -- general ---------------------------------------------------------------------------------------------------------------

procedure skew.aux.findorreplace (h :: skew, key :: anything) is
   return skew_aux_findorreplace(h, 'key', key)
end;

/* Returns the height of a key in skew heap h, with 0 depicting that the key is in the root node. */
procedure skew.height (h :: skew, key :: anything, height) is
   height := height or 0;
   if local head := rawget(h, 'l') then
      if head.key = key then
         return height
      fi;
      # recursive instead iterative approach in order to not destroy the heap during traversal
      if local r := procname(skew_nextbranch(h, 'l'), key, height + 1) then return r end;
      return procname(skew_nextbranch(h, 'r'), key, height + 1)
   fi;
   return null
end;


/* The factory returns an iterator that with each call returns a key~value pair from the heap, in an ordered fashion.
   The ordering is determined by the comparison function passed to `skew.new`, which by default is a `less than`
   comparison, so that the iterator returns the values in ascending order of its indices. */
local procedure skew_iterate (h, branch, tbl) is
   if local head := rawget(h, branch) then
      insert head.key into tbl;
      # recursive instead iterative approach in order to not destroy the heap during traversal
      if local r := procname(skew_nextbranch(h, 'l'), branch, tbl) then return r end;
      return procname(skew_nextbranch(h, 'r'), branch, tbl)
   fi
end;

procedure skew.iterate (h :: skew, branch) is
   local c, tbl, sizetbl;
   create table tbl(h.length or 0, h.length or 0);
   skew_iterate(h, branch or 'l', tbl);  # this ensures that the heap is iterated in an ordered fashion
   sort(tbl, h.comparison);
   sizetbl, c := size tbl, 0;
   return proc() is
      local idx;
      c >= sizetbl ? return null;
      idx := tbl[++c];
      return idx, skew.get(h, idx)
   end
end;


/* The function returns all indices in the heap in a new table. For the ordering, see `skew.iterate`. */
procedure skew.indices (h :: skew, branch) is
   create local table tbl(h.length or 0, h.length or 0);
   skew_iterate(h, branch or 'l', tbl);  # this ensures that the heap is iterated in an ordered fashion
   sort(tbl, h.comparison);
   return tbl
end;


/* The function returns all entries in the heap in a new table. For the ordering, see `skew.iterate`. */
procedure skew.entries (h :: skew, branch) is
   return <: x -> skew.get(h, x) :> @ skew.indices(h, branch or 'l')
end;

# -- insertion, popping and maintenance ------------------------------------------------------------------------------------

/* Inserts a new key~value pair into the skew heap if v is non-null, or deletes the key~value pair from the
   heap if v is `null`. The function returns nothing. */
procedure skew.include (h :: skew, ?) is
   local k, v;
   if nargs = 2 then    # 4.2.6 extension: just append new element
      k, v := h.length + 1, ?[1]
   else
      k, v := op(?)
   fi;
   assume(k or v, 'you cannot insert `null` into a heap');
   local r := skew_aux_findorreplace(h, 'key', k, v, 'write');
   if r = null then  # key not yet in heap ?
      if v <> null then  # insert key~value pair
         local new := [key = k, value = v];
         settype(new, 'skew');
         skew_merge(h, new, rawget(h, 'l'));
         h.length +:= 1
      fi
   elif skew.aux.directdelete and v = null then  # delete key~value pair ?
      local oldlen := h.length;
      for k, v in r do          # r includes all the key~value pairs that are in the child nodes after calling skew_aux_findorreplace,
         skew.include(h, k, v)  # so re-insert them.
      od;
      h.length := oldlen - 1
   elif not(skew.aux.directdelete) and v = null then
      error('Error in `skew.include`: cannot delete child nodes.')
   fi
end;


/* If just given h, removes the key~value pair with the lowest key and returns the key and the value removed. If the optional
   key k is given, removes the matching key~value pair from h and returns the key and the value removed. If the key does not exist,
   the function just returns `null`. */
procedure skew.remove (h :: skew, k) is
   return when size h = 0 with null;  # if the heap is empty, just return
   if k then  # remove a specific key~value pair
      if local v := skew.get(h, k) then
         skew.include(h, k, null);
         return k, v
      fi;
      return null
   fi;
   local result := rawget(h, 'l');     # pick the root node
   skew_merge(h, result.l, result.r);  # remove it
   h.length -:= 1;
   return result.key, result.value
end;


/* The function balances skew heap h internally by popping the node with the highest priority and then re-inserting it. This is
   just for maintenance, you do not have to run this function before executing any other package function. 2.27.6 u1 */
procedure skew.reorder (h :: skew) is
   skew.include(h, skew.remove(h))
end;

# --------------------------------------------------------------------------------------------------------------------------
# Binary heap
# Copyright (c) 2007-2011 Incremental IP Limited.
# --------------------------------------------------------------------------------------------------------------------------

create table binary;
create table binary.aux;

# -- metamethods -----------------------------------------------------------------------------------------------------------

procedure binary.aux.mt_size (h :: binary) is
   return h.length
end;

procedure binary.aux.mt_empty (h :: binary) is
   return h.length = 0
end;

procedure binary.aux.mt_filled (h :: binary) is
   return h.length <> 0
end;

procedure binary.aux.mt_index (h :: binary, key :: anything) is  # obsolete
   return binary.find(h, key, 'key')
end;

procedure binary.aux.mt_in (key :: anything, h :: binary) is  # 2.27.8 fix
   return binary.find(h, key)
end;

procedure binary.aux.mt_notin (key :: anything, h :: binary) is  # 2.27.8 fix
   return unassigned binary.find(h, key)
end;

# -- heap construction -----------------------------------------------------------------------------------------------------

/* Creates an empty heap with the default comparison method for various operations the `less than` relation, i.e.
   <: k1, k2 -> k1 and type k1 = type k2 and k1 < k2 :>. You might pass another comparison function to be used.
   Extended 4.3.0 */
procedure binary.new (comparison) is
   local h, mt;
   h := [ values = [], comparison = comparison or default_comparison, length = 0 ];
   mt := [
      __empty  = binary.aux.mt_empty,
      __filled = binary.aux.mt_filled,
      __size   = binary.aux.mt_size,
      __in     = binary.aux.mt_in,
      __notin  = binary.aux.mt_notin,
      include  = binary.include,
      remove   = binary.remove,
      find     = binary.find,
      get      = binary.get,
      indices  = binary.indices,
      entries  = binary.entries,
      reorder  = binary.reorder,
      check    = binary.check
   ];
   mt.__index := mt;  # register methods
   setmetatable(h, mt, 'binary');
   return h
end;

# -- insertion and popping -------------------------------------------------------------------------------------------------

/* Inserts a new key~value pair into the binary heap h. The function returns nothing. */
procedure binary.include (h :: binary, ?) is
   local cmp, newrecord, rightborder, middle, middlerecord, d, k, v;
   if nargs = 2 then  # 4.2.6 extension: just append new element
      k, v := h.length + 1, ?[1]
   else
      k, v := op(?)
   fi;
   assume(k, 'You cannot insert `null` into a heap');
   cmp := h.comparison;
   # float the new key up from the bottom of the heap
   h.length++;
   newrecord := rawgeti(h, h.length);  # keep the old table to save garbage
   rightborder := h.length;
   d := h.values;
   # Records will not be inserted in an ordered fashion; instead, only the pair with the highest priority will be at d[1]
   # after insertion.
   while rightborder > 1 do
      middle := rightborder \ 2;
      middlerecord := rawgeti(d, middle);
      if cmp(k, middlerecord.key) then  # shift record with lower prio to the right
         d[rightborder] := middlerecord
      else
         break
      end;
      rightborder := middle
   end;
   if newrecord then  # length > 0 ?
      newrecord.key := k;
      newrecord.value := v
   else
      newrecord := [ key = k, value = v ]
   end;
   d[rightborder] := newrecord
end;


/* Removes the key~value pair with the highest priority and returns the key and the value removed. */
procedure binary.remove (h :: binary) is
   local cmp, result, last, last_key, parent_index, child_index, child_rec, child_key, d;
   h.length = 0 ? return null;
   cmp := h.comparison;
   # pop the top of the heap
   d := h.values;
   result := d[1];
   # push the last element in the heap down from the top
   last := d[h.length];
   last_key := (last and last.key) or null;
   # keep the old record around to save on garbage
   d[h.length] := d[1];
   h.length -:= 1;
   parent_index := 1;
   while 2*parent_index <= h.length do
      child_index := 2*parent_index;
      if child_index + 1 <= h.length and cmp(d[child_index + 1].key, d[child_index].key) then
         child_index +:= 1
      end;
      child_rec := d[child_index];
      child_key := child_rec.key;
      if cmp(last_key, child_key) then
         break
      else
         d[parent_index] := child_rec;
         parent_index := child_index
      end
   end;
   d[parent_index] := last;
   return result.key, result.value
end;

# -- searching -------------------------------------------------------------------------------------------------------------

procedure binary.find (h :: binary, k :: anything, what) is
   local d, cmp := h.values, h.comparison;
   assume(k, '`null` cannot be part of a heap');
   # the records in the heap are unordered, so we have to search linearly
   # Try to guess the position: records with lower prio often are at the right half of h.values
   if what = 'key' then
      if cmp(k, d[h.length\2].key) then
         for i to h.length do
            if d[i].key = k then return d[i].value fi
         od
      else
         for i from h.length downto 1 do
            if d[i].key = k then return d[i].value fi
         od
      end
   else
      for i to h.length do
         if d[i].value = k then return d[i].key fi
      od
   end;
   return null
end;


procedure binary.get (h :: binary, k :: anything) is  # 4.3.0
   return binary.find(h, k, 'key')
end;


# Explores the internal structure of binary heap h and returns a table with all its levels in various subtables.
# The key~value pair with the highest priority, at level 1, is in the first subtable of the result and is the one
# that would be popped first if `binary.remove` would be called. All the other entries are at higher levels and
# will not necessarily be returned in the order when popped by `binary.remove`. All the key~value pairs are
# represented by pairs with the key at the left-hand side and the value at the right-hand side. 4.2.5 u1
procedure binary.explore (h :: binary) is
   local r, getnode, s;
   s := h.length;
   procedure getnode(lines, i, level) is
      local left_child_index, k, v;
      if s < 1 then return end;
      lines[level] := lines[level] or []
      k := h.values[i].key;
      v := h.values[i].value;
      left_child_index := 2*i;
      if left_child_index <= s then
         getnode(lines, left_child_index, level + 1)
      end;
      if left_child_index + 1 <= s then
         getnode(lines, left_child_index + 1, level + 1)
      end;
      insert k:v into lines[level]
   end;
   r := [];
   getnode(r, 1, 1);
   return r
end;


/* The function returns all indices in binary heap h in a new table. For the ordering, see `binary.iterate`. */
procedure binary.indices (h :: binary) is
   local k, d;
   create table k(h.length);
   d := h.values;
   for i to h.length do
      k[i] := d[i].key
   od;
   sort(k, h.comparison);
   return k
end;


/* The function returns all entries in binary heap h in a new table. For the ordering, see `binary.iterate`.
   Rewritten 4.2.6 */
procedure binary.entries (h :: binary) is
   local tbl, h0, v;
   create table tbl(h.length);
   h0 := copy(h);
   while h0.length <> 0 do
      v := drop(1, binary.remove(h0));
      insert v into tbl
   od;
   return tbl
end;


/* The factory returns an iterator that with each call returns a key~value pair from binary heap h, in an ordered fashion.
   The ordering is determined by the comparison function passed to `binary.new`, which by default is a `less than`
   comparison, so that the iterator returns the values in ascending order of its indices. */
procedure binary.iterate (h :: binary) is
   local h0 := copy(h);
   return proc() is
      return binary.remove(h0)
   end;
end;


/* Deletes all obsolete datasets in binary heap h - to free memory. */
procedure binary.reorder (h :: binary) is
   local d := h.values;
   purge(d, h.length + 1, size d)
end;

# -- checking --------------------------------------------------------------------------------------------------------------

procedure binary.check (h :: binary) is
   local cmp, i, d := h.comparison, 1, h.values;
   do
      if i*2 > h.length then return true end;
      if cmp(d[i*2].key, d[i].key) then return false end;
      if i*2 + 1 > h.length then return true end;
      if cmp(d[i*2 + 1].key, d[i++].key) then return false end
   end
end;


##############################################################################################
# clock package functions                                                                    #
##############################################################################################

if unassigned(_clockAdjust) then
   _clockAdjust := true
fi;


# Metatable for adding, subtracting, multiplying, and dividing tm values
clock.clock_mt := [
   __add = proc(a, b) is
              return clock.add(a, b)
           end,
   __sub = proc(a, b) is
              return clock.sub(a, b)
           end,
   __mul = proc(a, b) is
              return clock.muls(a, b)
           end,
   __div = proc(a, b) is  # Agena 1.6.0, patched 1.11.4
              return clock.divs(a, b)
           end,
   __pow = proc(a, b) is  # Agena 1.11.4u1
              return clock.pow(a, b)
           end,
   __unm = proc(a) is
              return clock.muls(-1, a)
           end,
   __lt =  proc(a :: tm, b :: tm) is
              return clock.todec(a) < clock.todec(b)
           end,
   __eq =  proc(a :: tm, b :: tm) is
              return clock.todec(a) = clock.todec(b)
           end,
   __abs = proc(a :: tm) is
              return clock.tm(|a[1]|, |a[2]|, |a[3]|)
           end,
   __sign = proc(a :: tm) is
               return sign(clock.todec(a))
           end,
   # from here on, applying these operators on time values may not make any sense at all
   __sqrt = proc(a :: tm) is
              return clock.totm(sqrt(clock.todec(a)))
           end,
   __ln =  proc(a :: tm) is
              return clock.totm(ln(clock.todec(a)))
           end,
   __exp = proc(a :: tm) is
              return clock.totm(exp(clock.todec(a)))
           end,
   __sin = proc(a :: tm) is
              return clock.totm(sin(clock.todec(a)))
           end,
   __cos = proc(a :: tm) is
              return clock.totm(cos(clock.todec(a)))
           end,
   __tan = proc(a :: tm) is
              return clock.totm(tan(clock.todec(a)))
           end,
   __arcsin = proc(a :: tm) is  # 3.16.0
              return clock.totm(arcsin(clock.todec(a)))
           end,
   __arccos = proc(a :: tm) is  # 3.16.0
              return clock.totm(arccos(clock.todec(a)))
           end,
   __arctan = proc(a :: tm) is
              return clock.totm(arctan(clock.todec(a)))
           end,
   # misc
   __tostring = proc(a :: tm) is
              return 'tm(' & a[1] & ', ' & a[2] & ', ' & a[3] & ')'
           end
];


# define a time object, tuned 2.9.7, changed to tuples 3.15.5, no speed-up, but not slower
clock.tm := proc(?) is
   local r, item;
   nargs < 1 or nargs > 3 ? error('Error in `clock.tm`: wrong number of arguments.');  # changed 2.14.0
   item := ?[1];
   if item :: pair then  # handle tm format [hh:]mm:ss (as pair or nested pair)
      if right(item) :: pair then
         r := tuples.new(left(item), left(right(item)), right(right(item)))
      else
         r := tuples.new(0, left(item), right(item))
      fi
      # item has now been converted to its tuple representation
   else
      case nargs
         of 1 then r := tuples.new(0, ?[1], 0)
         of 2 then r := tuples.new(0, ?[1], ?[2])
         else      r := tuples.new(op(?))
      esac
   fi;
   tuples.isall(r, number) -? error('Error in `clock.tm`: numbers expected.');
   addtometatable(r, clock.clock_mt, 'tm');
   if _clockAdjust then clock.adjust(r) fi;
   return r
end;


# adds two or more values of type tm
clock.add := proc(?) is
   local hours, minutes, seconds -> 0;
   for i in ? do
      if i -: 'tm' then
         argerror(i, 'clock.add', 'expected a `tm` value')
      else
         inc hours, i[1];
         inc minutes, i[2];
         inc seconds, i[3]
      fi
   od;
   return clock.tm(hours, minutes, seconds)
end;


# subtract two or more values of type tm
clock.sub := proc(?) is
   local hours, minutes, seconds, item, first;
   first := ?[1];
   hours := first[1];
   minutes := first[2];
   seconds := first[3];
   for i from 2 to nargs do
      item := ?[i];
      if item -: 'tm' then
         argerror(item, 'clock.sub', 'expected a `tm` value')
      else
         dec hours, item[1];
         dec minutes, item[2];
         dec seconds, item[3]
      fi
   od;
   if minutes > 0 then
      while seconds < 0 do
         inc seconds, 60;
         dec minutes, 1
      od;
      while minutes < 0 do
         inc minutes, 60;
         dec hours, 1
      od;
   fi;
   return clock.tm(hours, minutes, seconds)
end;


# multiplication
clock.muls := proc(v1, v2) is
   local factor, struct, inseconds;
   if nargs <> 2 then
      error('Error in `clock.muls`: two arguments expected.')
   elif v1 :: 'tm' and v2 :: number then
      struct, factor := v1, v2
   elif v1 :: number and v2 :: 'tm' then
      struct, factor := v2, v1
   elif v1 :: 'tm' and v2 :: 'tm' then
      struct, factor := v2, clock.todec(v1)
   else
      error('Error in `clock.muls`: arguments must be of type `tm` and/or type number.')
   fi;
   inseconds := struct[1] * 3600 + struct[2] * 60 + struct[3];
   return clock.tm(0, factor * inseconds)
end;


# division
clock.divs := proc(v1, v2) is
   local factor, struct, inseconds;
   if nargs <> 2 then
      error('Error in `clock.divs`: two arguments expected.')
   elif v1 :: 'tm' and v2 :: number then
      struct, factor := v1, v2;
      return when zero factor with undefined;  # changed 2.14.0
      inseconds := struct[1] * 3600 + struct[2] * 60 + struct[3];
      return clock.tm(0, inseconds / factor)
   elif v1 :: number and v2 :: 'tm' then
      struct, factor := v2, v1 * 3600;
      inseconds := struct[1] * 3600 + struct[2] * 60 + struct[3];
      return when zero inseconds with undefined;  # changed 2.14.0
      return clock.tm(factor / inseconds, 0, 0)
   elif v1 :: 'tm' and v2 :: 'tm' then
      struct, factor := v1, v2;
      factor := factor[1] * 3600 + factor[2] * 60 + factor[3];
      return when zero factor with undefined;
      inseconds := struct[1] * 3600 + struct[2] * 60 + struct[3];
      return clock.tm(inseconds / factor, 0, 0)
   else
      error('Error in `clock.divs`: arguments must be of type `tm` and/or type number.')
   fi;
end;


# exponentiation
clock.pow := proc(?) is
   local v1, v2 := ?[1], ?[2];
   if nargs <> 2 then
      error('Error in `clock.pow`: two arguments expected.')
   elif v1 :: 'tm' and v2 :: number then
      return clock.totm(clock.todec(v1) ^ v2)
   elif v1 :: number and v2 :: 'tm' then
      return clock.totm(v1 ^ clock.todec(v2))
   elif v1 :: 'tm' and v2 :: 'tm' then
      return clock.totm(clock.todec(v1) ^ clock.todec(v2))
   else
      error('Error in `clock.pow`: arguments must be of type `tm` and/or type number.')
   fi;
end;


# Converts a time value in decimals (of type number) into its `tm` representation.

clock.totm := proc(x :: number) is  # 2.12.1 modification
   local h, m, s, f, sgn;
   nan(x) ? return undefined;   # 3.16.0 change
   sgn := signum(x); x := |x|;  # ditto
   h, f := int(x), frac(x);
   m := int(f*60);
   s := round(frac(f*60)*60, 2);  # 1.12.0 u1
   return clock.tm(sgn*h, sgn*m, sgn*s)
end;


# Converts a `tm` value into its decimal representation of type number. Please have a look at the
# `clock` package chapter for further details.

clock.todec := proc(x :: tm) is
   return x[1] + (x[2]*60 + x[3])/3600
end;



# converts a float or `tm` value into its sexagesimal string representation of the format hh:mm:ss, 1.12.0 u1.
clock.sgstr := proc(x, d) is
   local rtm, str;
   if x :: number then
      rtm := clock.totm(x)
   elif x :: 'tm' then
      rtm := x
   else
      argerror(x, 'clock.sgstr', 'number or `tm` value expected for first argument')
   fi;
   create sequence str(3);
   if unassigned(d) then
      d := ':'
   elif d -: string then
      argerror(d, 'clock.sgstr', 'expected a string as second argument')
   fi;
   for i to 3 do
      insert strings.rjustify(int(rtm[i]), 2, '0') into str
   od;
   if fractional(rtm[3]) then  # 1.12.4 patch for fractional seconds
      local seconds := tostring(rtm[3]);
      str[3] := str[3] & seconds['.' in seconds to -1]  # 2.14.11
   fi;
   return strings.join(str, d)
end;


##############################################################################################
# bimaps package functions                                                                   #
##############################################################################################

/*** Metamethods ****************************************************************************/

local bimaps_mt_newindex := proc(l, r) is
   return proc(t, k, v) is
      if v then
         /* 4.7.3 improvement, deliberately issue an error instead of just ignoring the assignment request,
            but ignore if the same value is to be reassigned to the key. */
         if r[v] then
            if l[k] <> v then
               error(
                  strings.format(
                     'Error, cannot assign value %Q to key %Q: already assigned to key %Q.',
                     tostring(v), tostring(k), tostring(r[v])
                  ), 2
               )
            fi;
            return
         fi;
         r[v] := k
      end;
      l[k] ? r[l[k]] := null;
      l[k] := v
   end
end;

local bimaps_mt_call := proc(l, r) is
   return proc(t, x, ?) is
      return l
   end
end;

local bimaps_mt_tostring := proc(t) is
   local u := tostringx(t());
   u := if u = '[]' then 'bimap()' else 'bimap(' & tostringx(t())[2 to -2] & ')' fi;
   return u
end;

/*** Functions ***********************************************************************************/

create table bimaps.aux;

/* Returns administrative information for bimap t, see `environ.attrib`. */
bimaps.attrib := proc(t) is
   local env := environ.attrib(t());  # outsmart the Agena prettyprinter by brute force
   env.metatable := true;
   return env
end;

bimaps.aux.checkargs := proc(o, p) is
   local inplace, b := checkoptions('bimaps.map', p, true)['inplace'];
   if inplace then
      remove(<: x -> x :: pair and left x = 'inplace' :>, p, inplace=true);
      tables.reshuffle(p);
      b := o
   else
      b := bimaps.bimap()
   fi;
   return b, inplace
end;


/* Maps a univariate or multivariate function f on all values in bimap b and by default returns a new bimap with the result.
   If you pass the `inplace = true' option, then the operation is done in-place, too, implicitly modifying the input bimap,
   too.

   If f has only one argument, then only the function and the object will be passed to `bimaps.map`.

   If the function has more than one argument, then all arguments except the first will be passed right after argument b.

   See also: bimaps.remove, bimaps.select, bimaps.subs. 4.7.3 */
bimaps.map := proc(f :: procedure, o :: bimap, ?) is
   local b := bimaps.aux.checkargs(o, ?);
   # let's save as much memory as possible, so we do not use `map`
   for i, j in getmetatable(o).__index do
      b[i] := f(j, op(?))
   od;
   return b
end;


/* Returns all values along with their keys in bimap bm that satisfy a condition determined by function f which should return
   `true` or `false`. By default, the return is a new bimap.

   If you pass the `inplace = true' option, then the operation is done in-place, too, implicitly modifying the input bimap, too.

   If f has more than one argument, then all arguments except the first will be passed right after argument bm.

   See also: bimaps.map, bimaps.remove. 4.7.3 */
bimaps.select := proc(f :: procedure, o :: bimap, ?) is
   local b, inplace, r := bimaps.aux.checkargs(o, ?);
   # let's save as much memory as possible
   for i, j in getmetatable(o).__index do
      r := f(j, op(?));
      if inplace and not r then
         b[i] := null;
      elif not(inplace) and r then
         b[i] := j
      fi
   od;
   return b
end;


/* Removes all values along with their keys in bimap bm that satisfy a condition determined by function f which should return
   `true` or `false`. By default, the return is a new bimap.

   If you pass the `inplace = true' option, then the operation is done in-place, too, implicitly modifying the input bimap, too.

   If f has more than one argument, then all arguments except the first will be passed right after argument bm.

   See also: bimaps.map, bimaps.select. 4.7.3 */
bimaps.remove := proc(f :: procedure, o :: bimap, ?) is
   local b, inplace, r := bimaps.aux.checkargs(o, ?);
   # let's save as much memory as possible
   for i, j in getmetatable(o).__index do
      r := f(j, op(?));
      if inplace and r then
         b[i] := null
      elif not(inplace or r) then
         b[i] := j
      fi
   od;
   return b
end;


/* Substitutes all occurrences of the value x in bimap bm with the value v, by default non-destructively.

   More than one substitution pair can be given. The substitutions are performed sequentially.

   If you pass the `inplace = true' option, then the operation is done in-place, too, implicitly modifying the input bimap, too.

   See also: bimaps.map. 4.7.3 */
bimaps.subs := proc(?) is
   local i, inplace, b, o, mt, pairs, lhs, rhs := 0, false;
   while ?[i + 1] :: pair do i++ od;
   if nargs < 2 then
      error('Error in `bimaps.subs`: need at least two arguments.')
   elif i = 0 then
      error('Error in `bimaps.subs`: first argument must be a pair, got ' & typeof ?[1] & '.')
   fi;
   pairs := ?[1 to i];
   o := ?[++i];
   if o -: 'bimap' then
      error('Error in `bimaps.subs`: expected a bimap, got ' & typeof o & '.')
   fi;
   b, inplace := bimaps.aux.checkargs(o, ?[i to nargs]);
   # let's save as much memory as possible
   mt := getmetatable(o).__index;
   for p in pairs do
      lhs, rhs := left p, right p;
      for i, j in mt do
         if lhs = j then
            b[i] := rhs
         elif not inplace then  # 4.7.3 u2 optimisation
            b[i] := j
         fi
      od;
      if not inplace then  # 4.7.3 u1 fix for more than one substitution pair
         mt := getmetatable(b).__index;
      fi
   od;
   return b
end;


/* Replaces a value in a bimap at a given index with a new value, by default non-destructively.

   More than one substitution pair can be given. The substitutions are performed sequentially.

   If you pass the `inplace = true' option, then the operation is done in-place, too, implicitly modifying the input bimap, too.

   See also: bimaps.map. 4.7.3 u2 */
bimaps.subsop := proc(?) is
   local i, inplace, b, o, mt, pairs, lhs, rhs := 0, false;
   while ?[i + 1] :: pair do i++ od;
   if nargs < 2 then
      error('Error in `bimaps.subsop`: need at least two arguments.')
   elif i = 0 then
      error('Error in `bimaps.subsop`: first argument must be a pair, got ' & typeof ?[1] & '.')
   fi;
   pairs := ?[1 to i];
   o := ?[++i];
   if o -: 'bimap' then
      error('Error in `bimaps.subsop`: expected a bimap, got ' & typeof o & '.')
   fi;
   b, inplace := bimaps.aux.checkargs(o, ?[i to nargs]);
   # let's save as much memory as possible
   mt := getmetatable(o).__index;
   for p in pairs do
      lhs, rhs := left p, right p;
      for i, j in mt do
         if lhs = i then
            b[i] := rhs
         elif not inplace then  # 4.7.3 u2 optimisation
            b[i] := j
         fi
      od;
      if not inplace then  # 4.7.3 u1 fix for more than one substitution pair
         mt := getmetatable(b).__index;
      fi
   od;
   return b
end;


/* Like `countitems`, but for bimaps. 4.7.3 u2 */
bimaps.countitems := proc(?) is
   if nargs < 2 then
      error('Error in `bimaps.countitems`: need at least two arguments.')
   elif ?[2] -: 'bimap' then
      error('Error in `bimaps.countitems`: expected a bimap, got ' & typeof ?[2] & '.')
   fi;
   ?[2] := ?[2]();  # fetch the underlying table and reinsert into varargs
   return countitems(op(?))
end;


/* Creates two tables representing a bi-directional map. You can initialise the bimap by passing an optional table with
   pre-defined values. */
bimaps.aux.Cmt := getmetatable('bimaps', true);

bimaps.bimap := proc(l_val) is
   local l_proxytab, r_proxytab, l_proxy, r_proxy;
   if unassigned l_val then
      l_val := []
   elif l_val -: table then
      error('Error in `bimaps.bimap`: expected a table, got ' & type l_val & '.')
   end;
   local r_val := [];
   for k, v in l_val do r_val[v] := k end;
   l_proxytab := [
      __index = l_val,
      __writeindex = bimaps_mt_newindex(l_val, r_val),
      __size = proc(t) is return size l_val end,  # 37 % faster than the C version
      __call = bimaps_mt_call(l_val, r_val),
      __tostring = bimaps_mt_tostring,
   ];
   r_proxytab := [
      __index = r_val,
      __writeindex = bimaps_mt_newindex(r_val, l_val),
      __size = proc(t) is return size r_val end,  # 37 % faster than the C version
      __call = bimaps_mt_call(r_val, l_val),
      __tostring = bimaps_mt_tostring,
   ];
   for i, j in bimaps.aux.Cmt do
      l_proxytab[i] := j;
      r_proxytab[i] := j
   od;
   l_proxy := setmetatable([], l_proxytab, 'bimap');
   r_proxy := setmetatable([], r_proxytab, 'bimap');
   return l_proxy, r_proxy
end;


##############################################################################################
# Command-line history aliases                                                               #
##############################################################################################

create table history;

history.on := proc(x) is
   if x :: string then
      environ.kernel(histfile = x)
   fi;
   environ.kernel(history = true)
end;

history.off := proc() is
   environ.kernel(history = false)
end;


##############################################################################################
# minizip Extension                                                                          #
##############################################################################################

local _ipairs := ipairs;

ipairs := proc(t) is
   local mt := getmetatable(t);
   if mt and mt.__ipairs then
      return mt.__ipairs(t)
   end;
   return _ipairs(t)
end;


##############################################################################################
# For compatibility of the ANSI version of Agena                                             #
##############################################################################################

# If executed by the ANSI version of Agena, load substitutes for some C99 library functions.
if ((os.isansi and os.isansi()) or environ.os = 'haiku') and mainlibname <> null then
   run (mainlibname & '/ansi.agn')
fi;

##############################################################################################
# Argument checks and error messages                                                         #
##############################################################################################

argerror := proc(v, prozname :: string, message :: string) is  # Agena 1.8.5 u1, changed 2.1.1
   error('Error in `' & prozname & '`: ' & message & ', got ' & typeof(v) & '.')
end;

