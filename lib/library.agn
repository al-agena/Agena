##############################################################################################
# dd package functions                                                                       #
##############################################################################################

# These are Agena ports of function originally written in Julia, Copyright (c) 2018-2023 Julia Math,
# and defined in DoubleFloats-1.6.2/src/math/elementary/archyptrig.jl, MIT-licended. 7.4.0

dd.sec := proc(x :: {userdata, number}) is
   return recip(cos(x))
end;

dd.csc := proc(x :: {userdata, number}) is
   return recip(sin(x))
end;

dd.cot := proc(x :: {userdata, number}) is
   return recip(tan(x))
end;

dd.csch := proc(x :: {userdata, number}) is
   infinite(x) ? return copysign(dd.naught, x);
   return recip(sinh(x))
end;

dd.sech := proc(x :: {userdata, number}) is
   infinite(x) ? return dd.naught;
   return recip(cosh(x))
end;

dd.coth := proc(x :: {userdata, number}) is
   |left x| > math.largest ? return copysign(dd.naught, x);
   return cosh(x)/sinh(x)
end;

dd.arcsinh := proc(x :: {userdata, number}) is
   nan(x) ? return x;
   infinite(x) ? return x;
   dd.signbit(x) = 1 ? return -dd.arcsinh(-x);
   local result := |x|;
   result +:= sqrt(square(result) + dd.one);
   return dd.copysign(ln(result), x)
end;

dd.arccosh := proc(x :: {userdata, number}) is
   nan(x) ? return x;
   infinite(x) and dd.signbit(x) = 0 ? return x;
   (x < dd.one or infinite(x)) ? return dd.undefined;
   local result := x + sqrt(square(x) - dd.one);
   return ln(result)
end;

dd.arctanh := proc(x :: {userdata, number}) is
   local twox, result;
   nan(x) ? return x;
   (abs(x) > dd.one or infinite(x)) ? return dd.undefined;
   twox := dd.new(left x + left x, right x + right x);
   result := dd.one + twox/(dd.one - x);
   result := ln(result);
   return dd.new(0.5*left result, 0.5*right result)
end;

dd.arccsch := proc(x :: {userdata, number}) is
   nan(x) ? return x;
   infinite(x) ? return dd.naught;
   zero(x) ? return if dd.signbit(x) = 1 then -dd.infinity else dd.infinity fi;
   local invx := recip(x);
   invx2 := recip(x*x);
   return ln(sqrt(1 + invx2) + invx)
end;

dd.arcsech := proc(x :: {userdata, number}) is
   nan(x) ? return x;
   (x < dd.naught or x > dd.one or infinite(x)) ? return dd.undefined;
   zero(x) ? return dd.infinity;
   x = dd.one ? return dd.naught;
   local invx := recip(x)
   return ln(dd.fma(sqrt(invx + dd.one), sqrt(invx - dd.one), invx))
end;

dd.arccoth := proc(x :: {userdata, number}) is
   nan(x) ? return x;
   infinite(x) ? return copysign(dd.naught, x);
   |x| = dd.one ? return sign(x)*dd.infinity;
   (-dd.one < x < dd.one) ? return dd.undefined;
   local invx := recip(x);
   return (ln(dd.one + invx) - ln(dd.one - invx))/dd.two
end;


##############################################################################################
# xbase package functions                                                                    #
##############################################################################################

xbase.wipe := proc(f, record :: number) is
   local flag;
   if not xbase.isopen(f) then
      error('Error in `xbase.wipe`: file handle is not valid.')
   elif fractional(record) or isnonposint(record) then
      error('Error in `xbase.wipe`: record number must be a posint.')
   fi;
   if record > xbase.records(f) then
      error('Error in `xbase.wipe`: record ' & record & ' does not exist.')
   fi;
   xbase.mark(f, record);
   flag := true;
   for i to xbase.fields(f) do  # 2.2.1 correction
      if xbase.purge(f, record, i) = false then
         if flag then  # unmark it if the first field has not yet been overwritten
            xbase.mark(f, record, false)
         fi;
         error('Error in `xbase.wipe`: record ' & i & ' could not be deleted.')
      fi;
      flag := false
   od
end;

# Register xbase.wipe as OOP method, 4.3.2
begin
   # prevent errors at initialisation in case package has been excluded in a sandbox
   if local get := registry{'get'}, get :: procedure then
      # insert metamethods written in Agena to internal registry metatable created in C
      local _mt := [ wipe = xbase.wipe ];
      if local mt := get('xbase'), mt :: table then
         for i, j in _mt do
            rawset(mt, i, j)
         od
      fi
    fi
end;


