# Skycrane package, initiated 18.08.2012

# Inspired August 05, 2012 JPL Time, by the upper stage called Skycrane that delivered Curiosity onto
# the surface of Mars. This package is automatically loaded when lib/library.agn is run at startup.

package.checkclib('skycrane');  # has C dynamic link library been found ?

skycrane.initstring :=
   'skycrane v1.4.1 as of July 24, 2025\n';

create table skycrane.aux;

skycrane.aux.fileop := proc(fn :: procedure, a :: string, b :: string, verbose) is  # Agena 1.7.6
   local aattribs, battribs, p, topp, r;
   verbose <> true ? verbose := false;
   a := skycrane.trimpath(a);
   b := skycrane.trimpath(b);
   p := a split '/';
   topp := top(p);
   if topp <> null and ('*' in topp or '?' in topp or topp = '.') then
      # is there a joker or dot in the end of the path ?
      pop top from p;
      p := strings.join(p, '/');
      for i in os.list(a, 'files') do
         skycrane.aux.fileop(fn, p & '/' & i, b) = fail ? return fail, i;
         verbose ? print(p & '/' & i)
      od;
      return true
   fi;
   aattribs := os.fstat(a);
   if aattribs = fail then
      return fail, a
   fi;
   if aattribs.mode = 'DIR' then
      for i in os.list(a, 'files') do
         skycrane.aux.fileop(fn, a & '/' & i, b) = fail ? return fail, i;
         verbose ? print(a & '/' & i)
      od;
      return true
   fi;
   battribs := os.fstat(b);
   if battribs :: table and battribs.mode = 'DIR' then
      local prep := a split '/';
      b &:= '/' & if prep = seq(a) then a else top(prep) fi;  # condition: no slash in path = true ? -> copy/move dir into new dir
      if fn = os.move and os.exists(b) then os.remove(b) fi   # file already exists in target path ? -> remove it
   fi;
   # copy or move file
   r := fn(a, b);
   verbose and r <> fail ? print(a);
   return r
end;

# Copies one or more files, accepts both source and target directories
skycrane.fcopy := proc(a :: string, b :: string, verbose) is  # Agena 1.8.10
   return skycrane.aux.fileop(os.fcopy, a, b, verbose)
end;

# Moves one or more files, accepts both source and target directories
skycrane.move := proc(a :: string, b :: string, verbose) is  # Agena 1.8.10
   return skycrane.aux.fileop(os.move, a, b, verbose)
end;


